  <searchcontent>Provider Configuration Editor&lt;div class="container-fluid form-builder"&gt;

    &lt;!-- Header --&gt;
    &lt;div class="builder-header d-flex justify-content-between align-items-center mb-4"&gt;
        &lt;div&gt;
            &lt;h3 class="mb-0"&gt;Form Configuration Builder&lt;/h3&gt;
            &lt;small class="text-muted"&gt;
                Configure pages, sections, and fields per enrollment type and provider type
            &lt;/small&gt;
        &lt;/div&gt;

        &lt;div class="d-flex align-items-center gap-3"&gt;
            &lt;span class="badge bg-light text-dark p-2"&gt;
                20 / 33 Fields Active
            &lt;/span&gt;
            &lt;button class="btn btn-primary"&gt;
                Save Configuration
            &lt;/button&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;!-- Enrollment Types --&gt;
    &lt;div class="mb-4"&gt;
        &lt;label class="text-uppercase small text-muted fw-bold"&gt;
            Enrollment Type
        &lt;/label&gt;

        &lt;div class="d-flex flex-wrap gap-3 mt-2"&gt;
            &lt;div class="config-card active"&gt;
                &lt;div class="card-title"&gt;New Provider Enrollment&lt;/div&gt;
                &lt;small&gt;Active&lt;/small&gt;
            &lt;/div&gt;

            &lt;div class="config-card"&gt;
                &lt;div class="card-title"&gt;Provider Re-enrollment&lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="config-card"&gt;
                &lt;div class="card-title"&gt;Bulk Group Intake&lt;/div&gt;
            &lt;/div&gt;

            &lt;div class="config-card add-card"&gt;
                + Add Type
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;!-- Provider Tabs --&gt;
    &lt;div class="mb-3"&gt;
        &lt;label class="text-uppercase small text-muted fw-bold"&gt;
            Provider
        &lt;/label&gt;

        &lt;div class="provider-tabs mt-2"&gt;
            &lt;button class="btn btn-sm btn-dark rounded-pill"&gt;Clinical&lt;/button&gt;
            &lt;button class="btn btn-sm btn-light rounded-pill"&gt;Ambulance / EMS&lt;/button&gt;
            &lt;button class="btn btn-sm btn-light rounded-pill"&gt;Social Workers&lt;/button&gt;
            &lt;button class="btn btn-sm btn-light rounded-pill"&gt;Pharmacy&lt;/button&gt;
            &lt;button class="btn btn-sm btn-light rounded-pill"&gt;Specialist / Surgical&lt;/button&gt;
            &lt;button class="btn btn-sm btn-light rounded-pill"&gt;Preventive Care&lt;/button&gt;
            &lt;button class="btn btn-sm btn-outline-secondary rounded-pill"&gt;
                + Add Provider
            &lt;/button&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;!-- Tabs --&gt;
    &lt;div class="nav-border mb-3"&gt;
        &lt;ul class="nav nav-tabs"&gt;
            &lt;li class="nav-item"&gt;
                #Form Fields&lt;/a&gt;
