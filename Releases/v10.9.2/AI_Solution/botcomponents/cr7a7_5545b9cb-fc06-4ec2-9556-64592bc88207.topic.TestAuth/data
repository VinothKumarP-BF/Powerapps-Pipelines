      conditions:
        - id: conditionItem_thacNE
          condition: =System.User.IsLoggedIn = true
          actions:
            - kind: SendActivity
              id: sendActivity_fiCBUB
              activity: logged in

      elseActions:
        - kind: SendActivity
          id: sendActivity_hiZmkp
          activity: not logged in

