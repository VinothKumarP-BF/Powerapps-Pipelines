<powerpagecomponent powerpagecomponentid="ebf3f796-0b85-f111-ab0f-70a8a5b028cc">
  <content>{
  "source": "&lt;!--&lt;link rel=\"stylesheet\" href=\"cmdsspp_enrollment_styles.css\"/&gt; --&gt;\r\n&lt;link rel=\"stylesheet\" href=\"cmdspp_enrollment_styles.css\"&gt;\r\n{% include 'cmdspp_Loader' %}\r\n   {% include 'cmdspp_ToastModal' %}\r\n&lt;div class=\"cmdspp-enrollment-page\"&gt;\r\n    \r\n    &lt;!-- Enrollment --&gt;\r\n    &lt;div class=\"cmdspp-enroll-page-title\"&gt;{{ pageTitle }}&lt;/div&gt;\r\n\r\n    &lt;!-- Container --&gt;\r\n    &lt;div class=\"cmdspp-main-container\"&gt;\r\n\r\n        &lt;!-- Heading 2 + Paragraph --&gt;\r\n        &lt;div class=\"cmdspp-info-container\"&gt;\r\n            &lt;div class=\"cmdspp-enroll-subtitle\"&gt;\r\n                {{ pageSubtitle }}\r\n            &lt;/div&gt;\r\n\r\n            &lt;div class=\"cmdspp-enroll-description\"&gt;\r\n                {{ pageDescription }}\r\n            &lt;/div&gt;\r\n        &lt;/div&gt;\r\n\r\n        &lt;!-- Container:margin --&gt;\r\n        &lt;div class=\"cmdspp-grid-wrapper\"&gt;\r\n            &lt;div id=\"cmdsppEnrollmentGrid\"\r\n                 class=\"cmdspp-enrollment-grid\"&gt;\r\n            &lt;/div&gt;\r\n        &lt;/div&gt;\r\n\r\n    &lt;/div&gt;\r\n    &lt;div id=\"cmdspp-enroll-provider-modal\"\r\n     class=\"cmdspp-enroll-modal-overlay\"&gt;\r\n\r\n    &lt;div class=\"cmdspp-enroll-modal\"&gt;\r\n\r\n        &lt;div class=\"cmdspp-enroll-modal-header\"&gt;\r\n            &lt;span&gt;Provider Type&lt;/span&gt;\r\n            &lt;span class=\"cmdspp-enroll-close\"&gt;&amp;times;&lt;/span&gt;\r\n        &lt;/div&gt;\r\n\r\n        &lt;div class=\"cmdspp-enroll-modal-body\"&gt;\r\n\r\n            &lt;div class=\"cmdspp-enroll-modal-description\"&gt;\r\n                Please select the provider type to continue\r\n            &lt;/div&gt;\r\n\r\n            &lt;label class=\"cmdspp-enroll-modal-label\"&gt;\r\n                Select Provider Type\r\n            &lt;/label&gt;\r\n\r\n            &lt;select id=\"cmdspp-enroll-provider-type\"\r\n                    class=\"cmdspp-enroll-provider-select\"&gt;\r\n                &lt;option value=\"\"&gt;Select&lt;/option&gt;\r\n                &lt;option value=\"Hospital\"&gt;Hospital&lt;/option&gt;\r\n                &lt;option value=\"Clinic\"&gt;Clinic&lt;/option&gt;\r\n                &lt;option value=\"Physician\"&gt;Physician&lt;/option&gt;\r\n                &lt;option value=\"Laboratory\"&gt;Laboratory&lt;/option&gt;\r\n            &lt;/select&gt;\r\n\r\n        &lt;/div&gt;\r\n\r\n        &lt;div class=\"cmdspp-enroll-modal-footer\"&gt;\r\n            &lt;button id=\"cmdspp-enroll-cancel-btn\"\r\n                    class=\"cmdspp-enroll-cancel-btn\"&gt;\r\n                Cancel\r\n            &lt;/button&gt;\r\n\r\n            &lt;button id=\"cmdspp-enroll-submit-btn\"\r\n                    class=\"cmdspp-enroll-submit-btn\"&gt;\r\n                Submit\r\n            &lt;/button&gt;\r\n        &lt;/div&gt;\r\n\r\n    &lt;/div&gt;\r\n\r\n&lt;/div&gt;\r\n&lt;/div&gt;\r\n\r\n&lt;script&gt;\r\n  // Safely embed the raw JSON string using the `json` filter (escapes quotes/HTML properly)\r\n  var cmdsppRaw = {{ settings[\"cmdspp_ENV_Automate_Flow_Url\"] | json }};\r\n   var currentUserId = window.cmdsppUserId ;\r\n   var currentEmailId = window.cmdsppEmailId ;\r\n  // If the setting value comes through as a string, parse it; if Liquid already gave an object, use as-is\r\n  var cmdsppUrls = typeof cmdsppRaw === \"string\" ? JSON.parse(cmdsppRaw) : cmdsppRaw;\r\n  \r\n  window.cmdsppConfig = {\r\n    pageTitle: \"{{ pageTitle }}\",\r\n    pageSubtitle: \"{{ pageSubtitle }}\",\r\n    pageDescription: \"{{ pageDescription }}\",\r\n    enrollmentApiUrl: cmdsppUrls?.cmdspp_Enrollmenttype,\r\n    currentUserId: currentUserId,\r\n    currentEmailId:currentEmailId\r\n  };\r\n&lt;/script&gt;\r\n\r\n&lt;script src=\"/cmdspp_enrollmentTypes.js\"&gt;&lt;/script&gt;"
}</content>
