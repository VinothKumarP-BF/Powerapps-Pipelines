function openAddCaseNotes(primaryControl) {
    var targetFormName = "Add Case Notes";
    var currentForm = primaryControl.ui.formSelector.getCurrentItem();

    if (currentForm && currentForm.getLabel() !== targetFormName) {
        primaryControl.ui.formSelector.items.forEach(function (item) {
            if (item.getLabel() === targetFormName) {
                item.navigate();
            }
        });
    }
}

