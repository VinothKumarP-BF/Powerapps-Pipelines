async function viewScreeningReport(primaryControl) {
    console.log("viewScreeningReport called");

    const newTab = window.open('', '_blank');

    if (!newTab) {
        alert('Please allow pop-ups for this site.');
        return;
    }

    try {
        const recordId = primaryControl.data.entity
            .getId()
            .replace(/[{}]/g, '');

        const result = await Xrm.WebApi.retrieveRecord(
            'cmdspp_p_dtl_tb',
            recordId,
            '?$select=cmdspp_p_screening_report_path'
        );

        const fileUrl = result.cmdspp_p_screening_report_path;

        if (!fileUrl) {
            newTab.close();
            alert('Screening report is not available.');
            return;
        }

        newTab.location.href = fileUrl;

    } catch (error) {
        if (newTab && !newTab.closed) {
            newTab.close();
        }

        console.error(error);
        alert(error.message);
    }
}