// ============================================================================

EnrollmentActionValidation.validateAction =
    async function (
        executionContext,
        actionType
    ) {

        var formContext =
            executionContext.getFormContext();


        var eventArgs =
            executionContext.getEventArgs();


        var config =
            EnrollmentActionValidation.Config;


        const notificationId =
            "ENROLLMENT_ACTION_VALIDATION";


        const reasonNotificationId =
            "DISPOSITION_REASON_REQUIRED";


        formContext.ui.clearFormNotification(
            notificationId
        );


        formContext.ui.clearFormNotification(
            "DISPOSITION_SUCCESS"
        );


        var reasonFieldName =
            null;


        var explanationFieldName =
            null;


        var reasonRequiredMessage =
            null;


        var targetStatus =
            null;


        var timelineStatus =
            null;


        var currentDate =
            getCurrentUtcDateMMDDYYYY();


        // ====================================================================
        // DENIAL
        // ====================================================================

        if (
            actionType ===
            "DENIAL"
        ) {

            reasonFieldName =
                config.DENIAL_REASON_FIELD;


            explanationFieldName =
                config.DENIAL_EXPLANATION_FIELD;


            reasonRequiredMessage =
                "Denial Reason is required.";


            targetStatus =
                config.DENIAL_STATUS_VALUE;


            timelineStatus =
                "Application Denied - " +
                currentDate;
        }


        // ====================================================================
        // CANCEL
        // ====================================================================

        else if (
            actionType ===
            "CANCEL"
        ) {

            reasonFieldName =
                config.CANCELLATION_REASON_FIELD;


            explanationFieldName =
                config.CANCEL_EXPLANATION_FIELD;


            reasonRequiredMessage =
                "Cancellation Reason is required.";


            targetStatus =
                config.CANCEL_STATUS_VALUE;


            timelineStatus =
                "Application Cancelled - " +
                currentDate;
        }


        else {

            eventArgs.preventDefault();


            formContext.ui.setFormNotification(
                "Invalid enrollment action type.",
                "ERROR",
                notificationId
            );


            return;
        }


        // ====================================================================
        // GET ATTRIBUTES
        // ====================================================================

        var reasonAttribute =
            formContext.getAttribute(
                reasonFieldName
            );


        var explanationAttribute =
            formContext.getAttribute(
                explanationFieldName
            );


        var statusAttribute =
            formContext.getAttribute(
                config.STATUS_FIELD
            );


        // ====================================================================
        // REASON FIELD
        // ====================================================================

        if (
            !reasonAttribute
        ) {

            eventArgs.preventDefault();


            formContext.ui.setFormNotification(
                "Reason field is not available on the form.",
                "ERROR",
                notificationId
            );


            return;
        }


        // ====================================================================
        // REASON ONCHANGE
        // ====================================================================

        reasonAttribute.removeOnChange(
            onDispositionReasonChange
        );


        reasonAttribute.addOnChange(
            onDispositionReasonChange
        );


        // ====================================================================
        // EXPLANATION OPTIONAL
        // ====================================================================

        if (
            explanationAttribute
        ) {

            explanationAttribute.setRequiredLevel(
                "none"
            );
        }


        // ====================================================================
        // STATUS FIELD
        // ====================================================================

        if (
            !statusAttribute
        ) {

            eventArgs.preventDefault();


            formContext.ui.setFormNotification(
                "Application Status field is not available on the form.",
                "ERROR",
                notificationId
            );


            return;
        }


        // ====================================================================
        // REASON REQUIRED
        // ====================================================================

        reasonAttribute.setRequiredLevel(
            "required"
        );


        var reason =
            reasonAttribute.getValue();


        clearInlineFieldNotification(
            formContext,
            reasonFieldName,
            reasonNotificationId
        );


        if (
            reason ===
                null ||

            reason ===
                undefined ||

            (
                typeof reason ===
                    "string" &&
                reason.trim() ===
                    ""
            ) ||

            (
                Array.isArray(
                    reason
                ) &&
                reason.length ===
                    0
            )
        ) {

            eventArgs.preventDefault();


            setInlineFieldNotification(
                formContext,
                reasonFieldName,
                reasonRequiredMessage,
                reasonNotificationId
            );


            return;
        }


        // ====================================================================
        // CURRENT RECORD ID
        // ====================================================================

        var sysId =
            formContext
                .data
                .entity
                .getId();


        if (
            sysId
        ) {

            sysId =
                sysId.replace(
                    /[{}]/g,
                    ""
                );
        }


        // ====================================================================
        // REASON DISPLAY TEXT
        // ====================================================================

        var reasonText =
            "";


        if (
            typeof reasonAttribute.getText ===
            "function"
        ) {

            try {

                reasonText =
                    reasonAttribute.getText();
            }

            catch (error) {

                reasonText =
                    "";
            }
        }


        if (
            Array.isArray(
                reasonText
            )
        ) {

            reasonText =
                reasonText.join(
                    ", "
                );
        }


        if (
            reasonText ===
                null ||

            reasonText ===
                undefined ||

            String(
                reasonText
            ).trim() ===
                ""
        ) {

            if (
                Array.isArray(
                    reason
                )
            ) {

                reasonText =
                    reason.join(
                        ", "
                    );
            }

            else {

                reasonText =
                    String(
                        reason
                    );
            }
        }


        // ====================================================================
        // OPTIONAL EXPLANATION
        // ====================================================================

        var explanation =
            explanationAttribute

                ? explanationAttribute.getValue()

                : null;


        // ====================================================================
        // ORIGINAL STATUS
        // ====================================================================

        var originalStatus =
            statusAttribute.getValue();


        // ====================================================================
        // UPDATE STATUS
        // ====================================================================

        statusAttribute.setValue(
            targetStatus
        );


        statusAttribute.setSubmitMode(
            "always"
        );


        // ====================================================================
        // LOGGED-IN USER
        // ====================================================================

        var loggedInUserNametext =
            await getLoggedInUserName(
                executionContext
            );


        // ====================================================================
        // TIMELINE DESCRIPTION
        // ====================================================================

        var timelineDescription;


        if (
            actionType ===
            "DENIAL"
        ) {

            timelineDescription =
                "Application Denied by " +
                loggedInUserNametext +
                " with reason " +
                reasonText +
                ".";
        }

        else {

            timelineDescription =
                "Application Cancelled by " +
                loggedInUserNametext +
                " with reason " +
                reasonText +
                ".";
        }


        if (
            explanation !==
                null &&
            explanation !==
                undefined &&
            String(
                explanation
            ).trim() !==
                ""
        ) {

            timelineDescription +=
                " Explanation: " +
                String(
                    explanation
                ).trim() +
                ".";
        }


        // ====================================================================
        // TIMELINE
        // ====================================================================

        if (
            originalStatus !==
                targetStatus &&
            sysId
        ) {

            await updateTimeLine(
                timelineStatus,

                timelineDescription,

                sysId,

                executionContext,

                loggedInUserNametext
            );
        }


        // ====================================================================
        // CLEAR VALIDATION
        // ====================================================================

        clearInlineFieldNotification(
            formContext,
            reasonFieldName,
            reasonNotificationId
        );


        formContext.ui.clearFormNotification(
            notificationId
        );


        // ====================================================================
        // SUCCESS
        // ====================================================================

        showTemporaryFormMessage(
            formContext,
            "Disposition processed successfully.",
            "DISPOSITION_SUCCESS"
        );


        return;
    };


