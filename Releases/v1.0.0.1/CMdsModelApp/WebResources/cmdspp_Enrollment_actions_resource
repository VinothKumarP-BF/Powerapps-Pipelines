// ============================================================================
// NETWORK ENROLLMENT SUBGRID ONLOAD
//
// Detect Add / Remove by comparing row count.
// ============================================================================

function NetworkEnrollmentSubgridOnLoad(
    executionContext
) {

    var formContext =
        executionContext.getFormContext();

    if (!formContext) {
        return;
    }

    var networkSubgrid =
        getNetworkEnrollmentSubgrid(
            formContext
        );

    if (!networkSubgrid) {
        return;
    }

    var grid =
        networkSubgrid.getGrid();

    if (!grid) {
        return;
    }

    var currentCount =
        grid.getTotalRecordCount();


    // First load
    if (
        NetworkEnrollmentSubgridState
            .initialized ===
        false
    ) {

        NetworkEnrollmentSubgridState
            .initialized =
                true;

        NetworkEnrollmentSubgridState
            .previousCount =
                currentCount;

        return;
    }


    var previousCount =
        NetworkEnrollmentSubgridState
            .previousCount;


    // Record added
    if (
        currentCount >
        previousCount
    ) {

        NetworkEnrollmentActions
            .showAddedSuccess(
                formContext
            );
    }


    // Record removed
    else if (
        currentCount <
        previousCount
    ) {

        NetworkEnrollmentActions
            .showRemovedSuccess(
                formContext
            );
    }


    NetworkEnrollmentSubgridState
        .previousCount =
            currentCount;
}


// ============================================================================
// REGISTER NETWORK ENROLLMENT SUBGRID ONLOAD
// ============================================================================

function registerNetworkEnrollmentSubgrid(
    formContext
) {

    if (!formContext) {
        return;
    }

    if (
        NetworkEnrollmentSubgridState
            .handlerRegistered ===
        true
    ) {

        return;
    }

    var networkSubgrid =
        getNetworkEnrollmentSubgrid(
            formContext
        );

    if (!networkSubgrid) {
        return;
    }

    if (
        typeof networkSubgrid.addOnLoad !==
        "function"
    ) {

        return;
    }

    if (
        typeof networkSubgrid.removeOnLoad ===
        "function"
    ) {

        networkSubgrid.removeOnLoad(
            NetworkEnrollmentSubgridOnLoad
        );
    }

    networkSubgrid.addOnLoad(
        NetworkEnrollmentSubgridOnLoad
    );

    NetworkEnrollmentSubgridState
        .handlerRegistered =
            true;

    try {

        var grid =
            networkSubgrid.getGrid();

        if (grid) {

            NetworkEnrollmentSubgridState
                .previousCount =
                    grid.getTotalRecordCount();

            NetworkEnrollmentSubgridState
                .initialized =
                    true;
        }
    }

    catch (error) {

        NetworkEnrollmentSubgridState
            .initialized =
                false;
    }
}


// ============================================================================
// APPROVAL VALIDATION
// ============================================================================

var ApprovalValidation =
    async function (
        executionContext
    ) {

        var formContext =
            executionContext.getFormContext();

        var eventArgs =
            executionContext.getEventArgs();

        var config =
            EnrollmentValidationConfig;

        var saveMode =
            eventArgs.getSaveMode();


        const notificationId =
            "NETWORK_VALIDATION";

        const networkNotificationId =
            "NETWORK_ENROLLMENT_REQUIRED";

        const effectiveDateNotificationId =
            "EFFECTIVE_DATE_REQUIRED";


        // ====================================================================
        // SECOND SAVE
        // ====================================================================

        if (
            EnrollmentValidationState
                .allowApprovalSaveOnce ===
            true
        ) {

            EnrollmentValidationState
                .allowApprovalSaveOnce =
                    false;

            return;
        }


        formContext.ui.clearFormNotification(
            notificationId
        );


        // ====================================================================
        // GET APPROVAL FIELDS
        // ====================================================================

        var effectiveDateAttribute =
            formContext.getAttribute(
                config.EFFECTIVE_DATE_FIELD
            );

        var retroactiveAttribute =
            formContext.getAttribute(
                config.RETROACTIVE_FIELD
            );

        var statusAttribute =
            formContext.getAttribute(
                config.STATUS_FIELD
            );

        var applicationIdAttribute =
            formContext.getAttribute(
                config.APPLICATION_ID_FIELD
            );

        var providerIdAttribute =
            formContext.getAttribute(
                config.PROVIDER_ID_FIELD
            );


        // ====================================================================
        // EFFECTIVE DATE FIELD
        // ====================================================================

        if (
            !effectiveDateAttribute
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Enrollment Effective Date field is not available on the form.",
                "ERROR",
                notificationId
            );

            return;
        }


        effectiveDateAttribute.removeOnChange(
            onEnrollmentEffectiveDateChange
        );

        effectiveDateAttribute.addOnChange(
            onEnrollmentEffectiveDateChange
        );


        effectiveDateAttribute.setRequiredLevel(
            "required"
        );


        var effectiveDate =
            effectiveDateAttribute.getValue();


        clearInlineFieldNotification(
            formContext,
            config.EFFECTIVE_DATE_FIELD,
            effectiveDateNotificationId
        );


        if (
            effectiveDate ===
            null
        ) {

            eventArgs.preventDefault();

            setInlineFieldNotification(
                formContext,
                config.EFFECTIVE_DATE_FIELD,
                "Enrollment Effective Date is required.",
                effectiveDateNotificationId
            );

            return;
        }


        // ====================================================================
        // RETROACTIVE ELIGIBILITY
        // ====================================================================

        if (
            !retroactiveAttribute
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Retroactive Eligibility field is not available on the form.",
                "ERROR",
                notificationId
            );

            return;
        }


        retroactiveAttribute.setRequiredLevel(
            "required"
        );


        var retroactiveEligibility =
            retroactiveAttribute.getValue();


        if (
            retroactiveEligibility ===
            null
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Retroactive Eligibility is required.",
                "ERROR",
                notificationId
            );

            return;
        }


        // ====================================================================
        // STATUS FIELD
        // ====================================================================

        if (
            !statusAttribute
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Application Status field is not available on the form.",
                "ERROR",
                notificationId
            );

            return;
        }


        // ====================================================================
        // APPLICATION ID FIELD
        // ====================================================================

        if (
            !applicationIdAttribute
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Application ID field is not available on the form.",
                "ERROR",
                notificationId
            );

            return;
        }


        // ====================================================================
        // PROVIDER ID FIELD
        // ====================================================================

        if (
            !providerIdAttribute
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Provider ID field is not available on the form.",
                "ERROR",
                notificationId
            );

            return;
        }


        // ====================================================================
        // APPLICATION ID VALUE
        // ====================================================================

        var applicationIdValue =
            applicationIdAttribute.getValue();


        if (
            applicationIdValue ===
                null ||

            applicationIdValue ===
                undefined ||

            String(
                applicationIdValue
            ).trim() ===
                ""
        ) {

            eventArgs.preventDefault();

            formContext.ui.setFormNotification(
                "Application ID is required before Provider ID can be generated.",
                "ERROR",
                notificationId
            );

            return;
        }


        // ====================================================================
        // CURRENT APPLICATION RECORD
        // ====================================================================

        var approvalId =
            formContext
                .data
                .entity
                .getId();


        // Allow initial create save
        if (
            !approvalId
        ) {

            return;
        }


        approvalId =
            approvalId.replace(
                /[{}]/g,
                ""
            );


        // ====================================================================
        // SAVE AND CONTINUE / AUTOSAVE
        //
        // Do not perform final Approval processing.
        // ====================================================================

        if (
            saveMode ===
                2 ||

            saveMode ===
                70
        ) {

            formContext.ui.clearFormNotification(
                networkNotificationId
            );

            return;
        }


        // ====================================================================
        // CANCEL CURRENT SAVE BEFORE ASYNC VALIDATION
        // ====================================================================

        eventArgs.preventDefault();


        var originalStatus =
            statusAttribute.getValue();


        var originalProviderId =
            providerIdAttribute.getValue();


        var statusPrepared =
            false;


        var providerIdPrepared =
            false;


        try {

            // =================================================================
            // NETWORK ENROLLMENT VALIDATION
            // =================================================================

            var query =
                "?$select=" +
                config.NETWORK_PRIMARY_KEY +

                "&$filter=_" +
                config.APPROVAL_LOOKUP +

                "_value eq " +
                approvalId +

                "&$top=1";


            var networkResult =
                await Xrm.WebApi
                    .retrieveMultipleRecords(
                        config.NETWORK_TABLE,
                        query
                    );


            var hasNetworkEnrollment =
                networkResult
                    .entities
                    .length >
                0;


            // =================================================================
            // NETWORK ENROLLMENT REQUIRED
            // =================================================================

            if (
                !hasNetworkEnrollment
            ) {

                formContext.ui.setFormNotification(
                    "At least one Network Enrollment record is required.",
                    "ERROR",
                    networkNotificationId
                );

                return;
            }


            formContext.ui.clearFormNotification(
                networkNotificationId
            );


            // =================================================================
            // APPROVED STATUS = 6
            // =================================================================

            statusAttribute.setValue(
                6
            );


            statusAttribute.setSubmitMode(
                "always"
            );


            statusPrepared =
                true;


            // =================================================================
            // GENERATE PROVIDER ID IF BLANK
            // =================================================================

            if (
                originalProviderId ===
                    null ||

                originalProviderId ===
                    undefined ||

                String(
                    originalProviderId
                ).trim() ===
                    ""
            ) {

                var generatedProviderId =
                    "PRV" +
                    String(
                        applicationIdValue
                    )
                        .trim()
                        .padStart(
                            10,
                            "0"
                        );


                providerIdAttribute.setValue(
                    generatedProviderId
                );


                providerIdAttribute.setSubmitMode(
                    "always"
                );


                providerIdPrepared =
                    true;
            }


            // =================================================================
            // APPROVAL TIMELINE
            // =================================================================

            if (
                originalStatus !==
                6
            ) {

                var currentDate =
                    getCurrentUtcDateMMDDYYYY();


                var loggedInUserName =
                    await getLoggedInUserName(
                        executionContext
                    );


                var providerIdValue =
                    providerIdAttribute.getValue();


                var description =
                    "Application Approved by " +
                    loggedInUserName +
                    " and Provider ID " +
                    providerIdValue +
                    " assigned successfully.";


                await updateTimeLine(
                    "Application Approved - " +
                        currentDate,

                    description,

                    approvalId,

                    executionContext,

                    loggedInUserName
                );
            }


            // =================================================================
            // CLEAR VALIDATION
            // =================================================================

            clearInlineFieldNotification(
                formContext,
                config.EFFECTIVE_DATE_FIELD,
                effectiveDateNotificationId
            );


            formContext.ui.clearFormNotification(
                notificationId
            );


            formContext.ui.clearFormNotification(
                networkNotificationId
            );


            // =================================================================
            // ALLOW SECOND SAVE
            // =================================================================

            EnrollmentValidationState
                .allowApprovalSaveOnce =
                    true;


            setTimeout(
                function () {

                    var savePromise =
                        formContext.data.save(
                            {
                                saveMode:
                                    1
                            }
                        );


                    if (
                        savePromise &&
                        typeof savePromise.catch ===
                            "function"
                    ) {

                        savePromise.catch(
                            function () {

                                EnrollmentValidationState
                                    .allowApprovalSaveOnce =
                                        false;


                                if (
                                    statusPrepared &&
                                    statusAttribute
                                ) {

                                    statusAttribute.setValue(
                                        originalStatus
                                    );


                                    statusAttribute.setSubmitMode(
                                        "always"
                                    );
                                }


                                if (
                                    providerIdPrepared &&
                                    providerIdAttribute
                                ) {

                                    providerIdAttribute.setValue(
                                        originalProviderId
                                    );


                                    providerIdAttribute.setSubmitMode(
                                        "always"
                                    );
                                }


                                formContext.ui.setFormNotification(
                                    "Unable to save the approved application.",
                                    "ERROR",
                                    notificationId
                                );
                            }
                        );
                    }

                },
                100
            );


            return;
        }

        catch (error) {

            if (
                statusPrepared &&
                statusAttribute
            ) {

                statusAttribute.setValue(
                    originalStatus
                );


                statusAttribute.setSubmitMode(
                    "always"
                );
            }


            if (
                providerIdPrepared &&
                providerIdAttribute
            ) {

                providerIdAttribute.setValue(
                    originalProviderId
                );


                providerIdAttribute.setSubmitMode(
                    "always"
                );
            }


            EnrollmentValidationState
                .allowApprovalSaveOnce =
                    false;


            formContext.ui.setFormNotification(
                "Unable to complete Approval validation.",
                "ERROR",
                notificationId
            );


            return;
        }
    };


