    EFFECTIVE_DATE_FIELD:
        "cmdspp_p_enrollment_effective_date",

    RETROACTIVE_FIELD:
        "cmdspp_p_retroactive_eligibility",

    STATUS_FIELD:
        "cmdspp_p_appln_status",

    APPLICATION_ID_FIELD:
        "cmdspp_p_sys_id",

    PROVIDER_ID_FIELD:
        "cmdspp_providerid",

    LOGGED_USER_FIELD:
        "cmdspp_loggeduser",

    // NETWORK ENROLLMENT
    NETWORK_TABLE:
        "cmdspp_p_netw_enrl_tb",

    NETWORK_PRIMARY_KEY:
        "cmdspp_p_netw_enrl_tbid",

    APPROVAL_LOOKUP:
        "cmdspp_p_application_id",

    // Leave blank to automatically locate the
    // Network Enrollment subgrid by table name.
    NETWORK_SUBGRID_NAME:
        ""
};


