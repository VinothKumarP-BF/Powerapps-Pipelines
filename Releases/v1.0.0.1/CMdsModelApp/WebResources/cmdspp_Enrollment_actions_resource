        formContext
    );


    var config =
        EnrollmentValidationConfig;


    // Reset subgrid state
    NetworkEnrollmentSubgridState
        .initialized =
            false;


    NetworkEnrollmentSubgridState
        .previousCount =
            null;


    NetworkEnrollmentSubgridState
        .handlerRegistered =
            false;


    // ========================================================================
    // EFFECTIVE DATE
    // ========================================================================

    var effectiveDateAttribute =
        formContext.getAttribute(
            config.EFFECTIVE_DATE_FIELD
        );


    if (
        effectiveDateAttribute
    ) {

        effectiveDateAttribute.removeOnChange(
            onEnrollmentEffectiveDateChange
        );


        effectiveDateAttribute.addOnChange(
            onEnrollmentEffectiveDateChange
        );


        // Default current date when blank
        if (
            effectiveDateAttribute.getValue() ===
            null
        ) {

            effectiveDateAttribute.setValue(
                new Date()
            );
        }


        // Clear stale notification
        if (
            effectiveDateAttribute.getValue() !==
            null
        ) {

            clearInlineFieldNotification(
                formContext,
                config.EFFECTIVE_DATE_FIELD,
                "EFFECTIVE_DATE_REQUIRED"
            );
        }
    }


    // ========================================================================
    // REGISTER SUBGRID ONLOAD
    // ========================================================================

    registerNetworkEnrollmentSubgrid(
        formContext
    );


    // Retry because subgrid may load after form
    setTimeout(
        function () {

            registerNetworkEnrollmentSubgrid(
                formContext
            );

        },
        500
    );


    setTimeout(
        function () {

            registerNetworkEnrollmentSubgrid(
                formContext
            );

        },
        1500
    );


    setTimeout(
        function () {

            registerNetworkEnrollmentSubgrid(
                formContext
            );

        },
        3000
    );
}


