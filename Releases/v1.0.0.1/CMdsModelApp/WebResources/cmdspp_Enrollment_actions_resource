// ============================================================================
// POST SAVE - CLOSE FORM AFTER TERMINAL DISPOSITION
//
// 4 = Denied
// 6 = Approved
// 7 = Cancelled
// ============================================================================

function onEnrollmentActionPostSave(
    executionContext
) {

    var formContext =
        executionContext.getFormContext();


    var eventArgs =
        executionContext.getEventArgs();


    if (
        !eventArgs ||
        typeof eventArgs.getIsSaveSuccess !==
            "function" ||
        eventArgs.getIsSaveSuccess() !==
            true
    ) {

        return;
    }


    var statusAttribute =
        formContext.getAttribute(
            "cmdspp_p_appln_status"
        );


    if (!statusAttribute) {

        return;
    }


    var statusValue =
        statusAttribute.getValue();


    if (
        statusValue === 4 ||
        statusValue === 6 ||
        statusValue === 7
    ) {

        formContext.ui.close();
    }
}


// ============================================================================
// REGISTER POST SAVE CLOSE HANDLER
// ============================================================================

function registerEnrollmentPostSave(
    formContext
) {

    if (!formContext) {

        return;
    }


    formContext.data.entity.removeOnPostSave(
        onEnrollmentActionPostSave
    );


    formContext.data.entity.addOnPostSave(
        onEnrollmentActionPostSave
    );
}


