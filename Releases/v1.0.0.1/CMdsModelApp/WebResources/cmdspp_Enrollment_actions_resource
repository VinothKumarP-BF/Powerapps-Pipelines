// ============================================================================
// POPULATE NETWORK ENROLLMENT DEFAULT DATES
//
// Beginning Date:
// Parent Application Enrollment Effective Date
//
// If unavailable:
// Current Date
//
// End Date:
// 12/31/9999
//
// IMPORTANT:
// cmdspp_p_application_id does NOT have to be on this form.
// Parent Application is obtained from createFromEntity.
// ============================================================================

async function populateNetworkEnrollmentDefaultDates(
    executionContext
) {

    var formContext =
        executionContext.getFormContext();


    // ========================================================================
    // ONLY RUN FOR CREATE FORM
    //
    // 1 = Create
    // ========================================================================

    if (
        formContext.ui.getFormType() !==
        1
    ) {

        return;
    }


    // ========================================================================
    // CONFIGURATION
    // ========================================================================

    // Parent Application table logical name
    const APPLICATION_TABLE =
        "cmdspp_p_dtl_tb";


    // Parent Enrollment Effective Date
    const EFFECTIVE_DATE_FIELD =
        "cmdspp_p_enrollment_effective_date";


    // Network Enrollment Beginning Date
    const BEGIN_DATE_FIELD =
        "cmdspp_p_begin_dt";


    // Network Enrollment End Date
    const END_DATE_FIELD =
        "cmdspp_p_end_dt";


    // ========================================================================
    // GET NETWORK ENROLLMENT DATE FIELDS
    // ========================================================================

    var beginDateAttribute =
        formContext.getAttribute(
            BEGIN_DATE_FIELD
        );


    var endDateAttribute =
        formContext.getAttribute(
            END_DATE_FIELD
        );


    if (
        !beginDateAttribute ||
        !endDateAttribute
    ) {

        return;
    }


    // ========================================================================
    // DEFAULT END DATE
    //
    // 12/31/9999
    //
    // Only when blank.
    // ========================================================================

    if (
        endDateAttribute.getValue() ===
        null
    ) {

        var defaultEndDate =
            new Date(
                9999,
                11,
                31,
                12,
                0,
                0
            );


        endDateAttribute.setValue(
            defaultEndDate
        );
    }


    // ========================================================================
    // DO NOT OVERWRITE EXISTING BEGIN DATE
    // ========================================================================

    if (
        beginDateAttribute.getValue() !==
        null
    ) {

        return;
    }


    // ========================================================================
    // FALLBACK BEGIN DATE = CURRENT DATE
    // ========================================================================

    var defaultBeginDate =
        new Date();


    try {

        // ====================================================================
        // GET PARENT APPLICATION FROM PAGE CONTEXT
        //
        // When Network Enrollment is created using:
        //
        // Application
        //    ↓
        // Network Enrollment subgrid
        //    ↓
        // Add
        //
        // Power Apps supplies the parent Application through:
        //
        // createFromEntity
        // ====================================================================

        var pageContext =
            Xrm.Utility.getPageContext();


        var createFromEntity =
            pageContext &&
            pageContext.input

                ? pageContext.input
                    .createFromEntity

                : null;


        // ====================================================================
        // NO PARENT CONTEXT
        //
        // Use current date.
        // ====================================================================

        if (
            !createFromEntity ||
            !createFromEntity.id
        ) {

            beginDateAttribute.setValue(
                defaultBeginDate
            );

            return;
        }


        // ====================================================================
        // VERIFY PARENT IS APPLICATION TABLE
        // ====================================================================

        if (
            createFromEntity.entityType &&
            createFromEntity.entityType !==
                APPLICATION_TABLE
        ) {

            beginDateAttribute.setValue(
                defaultBeginDate
            );

            return;
        }


        // ====================================================================
        // GET PARENT APPLICATION GUID
        // ====================================================================

        var applicationId =
            String(
                createFromEntity.id
            ).replace(
                /[{}]/g,
                ""
            );


        if (!applicationId) {

            beginDateAttribute.setValue(
                defaultBeginDate
            );

            return;
        }


        // ====================================================================
        // RETRIEVE PARENT ENROLLMENT EFFECTIVE DATE
        // ====================================================================

        var applicationRecord =
            await Xrm.WebApi.retrieveRecord(
                APPLICATION_TABLE,
                applicationId,

                "?$select=" +
                    EFFECTIVE_DATE_FIELD
            );


        var effectiveDateValue =
            applicationRecord[
                EFFECTIVE_DATE_FIELD
            ];


        // ====================================================================
        // USE PARENT ENROLLMENT EFFECTIVE DATE
        // ====================================================================

        if (
            effectiveDateValue !==
                null &&

            effectiveDateValue !==
                undefined &&

            String(
                effectiveDateValue
            ).trim() !==
                ""
        ) {

            var effectiveDate =
                convertDataverseDateToLocalDate(
                    effectiveDateValue
                );


            if (
                effectiveDate
            ) {

                beginDateAttribute.setValue(
                    effectiveDate
                );

                return;
            }
        }


        // ====================================================================
        // PARENT EFFECTIVE DATE BLANK
        //
        // Use current date.
        // ====================================================================

        beginDateAttribute.setValue(
            defaultBeginDate
        );
    }

    catch (error) {

        // ====================================================================
        // IF PARENT RETRIEVAL FAILS
        //
        // Still use current date.
        // ====================================================================

        if (
            beginDateAttribute.getValue() ===
            null
        ) {

            beginDateAttribute.setValue(
                defaultBeginDate
            );
        }
    }
}


// ============================================================================
// CONVERT DATAVERSE DATE TO LOCAL JAVASCRIPT DATE
//
// Supports:
// 2026-09-08
// 2026-09-08T00:00:00Z
//
// This avoids Date Only values shifting one day because of timezone handling.
// ============================================================================

function convertDataverseDateToLocalDate(
    value
) {

    if (!value) {

        return null;
    }


    var dateString =
        String(
            value
        ).substring(
            0,
            10
        );


    var parts =
        dateString.split(
            "-"
        );


    if (
        parts.length !==
        3
    ) {

        return null;
    }


    var year =
        parseInt(
            parts[0],
            10
        );


    var month =
        parseInt(
            parts[1],
            10
        );


    var day =
        parseInt(
            parts[2],
            10
        );


    if (
        isNaN(year) ||
        isNaN(month) ||
        isNaN(day)
    ) {

        return null;
    }


    return new Date(
        year,
        month - 1,
        day,
        12,
        0,
        0
    );
}