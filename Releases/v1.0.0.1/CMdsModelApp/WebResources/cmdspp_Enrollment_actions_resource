// ============================================================================
// GET FORM CONTEXT
// ============================================================================

function getFormContextFromInput(
    input
) {

    if (!input) {
        return null;
    }

    if (
        typeof input.getFormContext ===
        "function"
    ) {

        return input.getFormContext();
    }

    if (
        input.data &&
        input.ui
    ) {

        return input;
    }

    return null;
}


// ============================================================================
// INLINE FIELD NOTIFICATION
// ============================================================================

function setInlineFieldNotification(
    formContext,
    fieldName,
    message,
    notificationId
) {

    if (!formContext) {
        return;
    }

    var attribute =
        formContext.getAttribute(
            fieldName
        );

    if (!attribute) {
        return;
    }

    attribute.controls.forEach(
        function (control) {

            if (
                control &&
                typeof control.setNotification ===
                    "function"
            ) {

                control.setNotification(
                    message,
                    notificationId
                );
            }
        }
    );
}


// ============================================================================
// CLEAR INLINE FIELD NOTIFICATION
// ============================================================================

function clearInlineFieldNotification(
    formContext,
    fieldName,
    notificationId
) {

    if (!formContext) {
        return;
    }

    var attribute =
        formContext.getAttribute(
            fieldName
        );

    if (!attribute) {
        return;
    }

    attribute.controls.forEach(
        function (control) {

            if (
                control &&
                typeof control.clearNotification ===
                    "function"
            ) {

                control.clearNotification(
                    notificationId
                );
            }
        }
    );
}


// ============================================================================
// TEMPORARY FORM MESSAGE
// ============================================================================

function showTemporaryFormMessage(
    formContext,
    message,
    notificationId
) {

    if (!formContext) {
        return;
    }

    formContext.ui.clearFormNotification(
        notificationId
    );

    formContext.ui.setFormNotification(
        message,
        "INFO",
        notificationId
    );

    setTimeout(
        function () {

            formContext.ui.clearFormNotification(
                notificationId
            );

        },
        5000
    );
}


// ============================================================================
// UTC DATE MM/DD/YYYY
// ============================================================================

function getCurrentUtcDateMMDDYYYY() {

    var now =
        new Date();

    var month =
        String(
            now.getUTCMonth() + 1
        ).padStart(
            2,
            "0"
        );

    var day =
        String(
            now.getUTCDate()
        ).padStart(
            2,
            "0"
        );

    var year =
        now.getUTCFullYear();

    return (
        month +
        "/" +
        day +
        "/" +
        year
    );
}


// ============================================================================
// GET LOGGED-IN USER
//
// IMPORTANT:
// This only reads the current user's name.
// It does NOT update cmdspp_loggeduser on the application form.
// ============================================================================

async function getLoggedInUserName(
    executionContext
) {

    var userName =
        Xrm.Utility
            .getGlobalContext()
            .userSettings
            .userName;


    if (!userName) {

        return null;
    }


    userName =
        userName.replace(
            /\s*\(.*?\)\s*/g,
            ""
        );


    userName =
        userName.replace(
            /#/g,
            ""
        ).trim();


    return userName;
}


// ============================================================================
// UPDATE TIMELINE
//
// Timeline failure does NOT:
// - block save
// - restore status
// - show error
//
// cmdspp_loggeduser below belongs to the TIMELINE record,
// not the parent application record.
// ============================================================================

async function updateTimeLine(
    status,
    description,
    sysId,
    executionContext,
    loggedInUserName
) {

    try {

        var data = {};

        data[
            "cmdspp_p_inquiry_desc"
        ] =
            description;

        data[
            "cmdspp_p_inquiry_status"
        ] =
            status;

        data[
            "cmdspp_loggeduser"
        ] =
            loggedInUserName;

        data[
            "cmdspp_p_event_dt"
        ] =
            new Date();

        sysId =
            String(
                sysId
            ).replace(
                /[{}]/g,
                ""
            );

        data[
            "cmdspp_p_sys_id_fk@odata.bind"
        ] =
            "/cmdspp_p_dtl_tbs(" +
            sysId +
            ")";

        return await Xrm.WebApi.createRecord(
            "cmdspp_p_enrol_status_inquiry_tb",
            data
        );
    }

    catch (error) {

        return null;
    }
}


// ============================================================================
// EFFECTIVE DATE ONCHANGE
// ============================================================================

function onEnrollmentEffectiveDateChange(
    executionContext
) {

    var formContext =
        executionContext.getFormContext();

    var fieldName =
        EnrollmentValidationConfig
            .EFFECTIVE_DATE_FIELD;

    var attribute =
        formContext.getAttribute(
            fieldName
        );

    if (!attribute) {
        return;
    }

    var value =
        attribute.getValue();

    if (
        value ===
        null
    ) {

        setInlineFieldNotification(
            formContext,
            fieldName,
            "Enrollment Effective Date is required.",
            "EFFECTIVE_DATE_REQUIRED"
        );
    }

    else {

        clearInlineFieldNotification(
            formContext,
            fieldName,
            "EFFECTIVE_DATE_REQUIRED"
        );
    }
}


// ============================================================================
// DENIAL / CANCELLATION REASON ONCHANGE
// ============================================================================

function onDispositionReasonChange(
    executionContext
) {

    var attribute =
        executionContext.getEventSource();

    if (!attribute) {
        return;
    }

    var value =
        attribute.getValue();

    var hasValue =
        !(
            value === null ||
            value === undefined ||

            (
                typeof value ===
                    "string" &&
                value.trim() ===
                    ""
            ) ||

            (
                Array.isArray(
                    value
                ) &&
                value.length ===
                    0
            )
        );

    if (!hasValue) {
        return;
    }

    attribute.controls.forEach(
        function (control) {

            if (
                control &&
                typeof control.clearNotification ===
                    "function"
            ) {

                control.clearNotification(
                    "DISPOSITION_REASON_REQUIRED"
                );
            }
        }
    );
}


// ============================================================================
// FIND NETWORK ENROLLMENT SUBGRID
// ============================================================================

function getNetworkEnrollmentSubgrid(
    formContext
) {

    if (!formContext) {
        return null;
    }

    var configuredName =
        EnrollmentValidationConfig
            .NETWORK_SUBGRID_NAME;

    // Try configured subgrid name first
    if (
        configuredName &&
        String(
            configuredName
        ).trim() !==
            ""
    ) {

        var configuredControl =
            formContext.getControl(
                configuredName
            );

        if (
            configuredControl
        ) {

            return configuredControl;
        }
    }

    // Automatically locate by table logical name
    var foundControl =
        null;

    if (
        !formContext.ui ||
        !formContext.ui.controls
    ) {

        return null;
    }

    formContext.ui.controls.forEach(
        function (control) {

            if (
                foundControl ||
                !control
            ) {

                return;
            }

            try {

                if (
                    typeof control.getControlType !==
                    "function"
                ) {

                    return;
                }

                if (
                    control.getControlType() !==
                    "subgrid"
                ) {

                    return;
                }

                if (
                    typeof control.getEntityName !==
                    "function"
                ) {

                    return;
                }

                var entityName =
                    control.getEntityName();

                if (
                    entityName ===
                    EnrollmentValidationConfig
                        .NETWORK_TABLE
                ) {

                    foundControl =
                        control;
                }
            }

            catch (error) {

                return;
            }
        }
    );

    return foundControl;
}


