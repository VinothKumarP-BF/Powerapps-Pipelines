function validateField(executionContext, fieldName, validationType, validationParam, errorMessage) {
    var formContext = executionContext.getFormContext();
    var attribute = formContext.getAttribute(fieldName);

    if (!attribute) {
        console.warn("validateField: attribute not found -> " + fieldName);
        return;
    }

    var control = attribute.controls.get(0);
    var value = attribute.getValue();
    var isValid = true;

    if (value) {
        switch (validationType) {
            case "pattern":
                var pattern = new RegExp(validationParam);
                isValid = pattern.test(value);
                break;

            case "notFutureDate":
                var today = new Date();
                today.setHours(0, 0, 0, 0);
                var inputDate = new Date(value);
                inputDate.setHours(0, 0, 0, 0);
                isValid = inputDate <= today;
                break;

            default:
                console.warn("validateField: unknown validationType -> " + validationType);
                isValid = true; // don't block on a misconfigured call
        }
    }

    if (!isValid) {
        control.setNotification(errorMessage);
    } else {
        control.clearNotification();
    }
}

