function getLookupTimeText(attribute) {
    if (!attribute) {
        return null;
    }

    var value = attribute.getValue();

    if (!value || !value[0] || !value[0].name) {
        return null;
    }

    return value[0].name; // e.g. "9:00 PM"
}

function parseTimeToMinutes(timeText) {
    if (!timeText) {
        return null;
    }

    var match = timeText.trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);

    if (!match) {
        console.warn("parseTimeToMinutes: could not parse time -> " + timeText);
        return null;
    }

    var hours = parseInt(match[1], 10);
    var minutes = parseInt(match[2], 10);
    var period = match[3].toUpperCase();

    if (period === "PM" && hours !== 12) {
        hours += 12;
    }
    if (period === "AM" && hours === 12) {
        hours = 0;
    }

    return hours * 60 + minutes;
}

function validateTimeField(
    executionContext,
    fieldName,
    compareFieldName,
    validationType,
    operator,
    errorMessage
) {
    var formContext = executionContext.getFormContext();

    var fieldAttribute = formContext.getAttribute(fieldName);
    var compareAttribute = formContext.getAttribute(compareFieldName);
    var fieldControl = formContext.getControl(fieldName);

    if (!fieldAttribute || !compareAttribute || !fieldControl) {
        console.warn(
            "validateTimeField: attribute/control not found -> " +
            fieldName + " or " + compareFieldName
        );
        return;
    }

    var notificationId = "time_validation_" + fieldName;
    fieldControl.clearNotification(notificationId);

    if (validationType !== "timeComparison") {
        console.warn("validateTimeField: unsupported validationType -> " + validationType);
        return;
    }

    var currentText = getLookupTimeText(fieldAttribute);
    var comparisonText = getLookupTimeText(compareAttribute);

    if (!currentText || !comparisonText) {
        return;
    }

    var currentMinutes = parseTimeToMinutes(currentText);
    var comparisonMinutes = parseTimeToMinutes(comparisonText);

    if (currentMinutes === null || comparisonMinutes === null) {
        return;
    }

    var isValid = true;

    switch (operator) {
        case "lessThan":
            isValid = currentMinutes < comparisonMinutes;
            break;
        case "greaterThan":
            isValid = currentMinutes > comparisonMinutes;
            break;
        case "lessThanOrEqual":
            isValid = currentMinutes <= comparisonMinutes;
            break;
        case "greaterThanOrEqual":
            isValid = currentMinutes >= comparisonMinutes;
            break;
        case "equal":
            isValid = currentMinutes === comparisonMinutes;
            break;
        default:
            console.warn("validateTimeField: unsupported operator -> " + operator);
            return;
    }

    if (!isValid) {
        fieldControl.setNotification(errorMessage, notificationId);
    }
}