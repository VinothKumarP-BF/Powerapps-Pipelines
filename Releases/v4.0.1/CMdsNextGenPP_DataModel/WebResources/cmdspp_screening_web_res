async function onNpiChge(executionContext) {


    var formContext = executionContext.getFormContext();
    var npi = formContext.getAttribute("cmdspp_p_npi_id")?.getValue();
    var control = formContext.getAttribute("cmdspp_p_npi_id").controls.get(0)


    if (!npi) {
        return;
    }
    try {
        const envFlow = await getFlowURl()
        const envFlowObj = JSON.parse(envFlow);

        const flowUrl = envFlowObj['cmdspp_Verify_NPI_Number'];
        //"https://68800e766659e6b2b28f47b46ad295.0f.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/00/workflows/8afee1c0c50a4df2b8e9c052bbf2a34d/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=-M6XAJQVT5SEOShLFYkZ2LERT7fXggILJOZFAD5RLso"

        const response = await fetch(flowUrl, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                npi_number: npi
            })
        });

        const mainResult = await response.json();


        if (mainResult.isValid) {
            control.clearNotification();
            const parsed = typeof mainResult.data === "string"
                ? JSON.parse(mainResult.data)
                : mainResult.data;

            const result = parsed?.results?.[0];

            if (!result) {
                console.log("No results returned");
                return;
            }

            const basic = result.basic || {};
            const addressData = result.addresses?.[0] || {};

            if (basic.first_name || basic.authorized_official_first_name) {
                formContext.getAttribute("cmdspp_p_fst_nam")?.setValue(
                    basic.first_name || basic.authorized_official_first_name
                );
            }

            if (basic.last_name || basic.authorized_official_last_name) {
                formContext.getAttribute("cmdspp_p_lst_nam")?.setValue(
                    basic.last_name || basic.authorized_official_last_name
                );
            }


        } else {
            console.log("NPI not valid", npi);
            if (control) control.setNotification("The entered NPI number is invalid or could not be verified.", "ERROR", "npi_validation");
        }

    } catch (e) {
        console.error("npi onNpiChge error", e);
        if (control) control.setNotification("The entered NPI number is invalid or could not be verified.", "ERROR", "npi_validation");
    }
