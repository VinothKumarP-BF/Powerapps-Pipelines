function validateDocumentFile(executionContext) {

    var formContext = executionContext.getFormContext();

    var fileAttribute =
        formContext.getAttribute("cmdspp_p_file");

    if (!fileAttribute) {
        return;
    }

    // Clear previous error
    formContext.ui.clearFormNotification("fileValidation");

    var file = fileAttribute.getValue();

    if (!file) {
        return;
    }

    var allowedExtensions = [
        ".jpeg",
        ".jpg",
        ".png",
        ".pdf",
        ".tiff"
    ];

    var maxFileSizeBytes =
        10 * 1024 * 1024;

    // =====================================================
    // 1. FILE SIZE
    // =====================================================

    var fileSizeBytes =
        Number(file.fileSize);

    if (fileSizeBytes > maxFileSizeBytes) {

        formContext.ui.setFormNotification(
            "File size exceeds the maximum allowed limit of 10 MB.",
            "ERROR",
            "fileValidation"
        );

        return;
    }

    // =====================================================
    // 2. FILE FORMAT
    // =====================================================

    var fileName =
        file.fileName || "";

    var lastDotIndex =
        fileName.lastIndexOf(".");

    var extension = "";

    if (lastDotIndex !== -1) {

        extension =
            fileName
                .substring(lastDotIndex)
                .toLowerCase();
    }

    if (allowedExtensions.indexOf(extension) === -1) {

        formContext.ui.setFormNotification(
            "Invalid file format. Only supported document types can be uploaded.",
            "ERROR",
            "fileValidation"
        );

        return;
    }

    // Valid file
    formContext.ui.clearFormNotification(
        "fileValidation"
    );
}

