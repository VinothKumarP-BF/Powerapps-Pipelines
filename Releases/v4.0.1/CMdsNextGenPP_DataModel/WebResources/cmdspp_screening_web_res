function validateDateField(
    executionContext,
    fieldName,
    compareFieldName,
    validationType,
    operator,
    errorMessage
) {
    var formContext = executionContext.getFormContext();

    var fieldAttribute = formContext.getAttribute(fieldName);
    var compareAttribute = formContext.getAttribute(compareFieldName);
    var fieldControl = formContext.getControl(fieldName);

    if (!fieldAttribute || !compareAttribute || !fieldControl) {
        console.warn(
            "Date validation field not found: " +
            fieldName +
            " or " +
            compareFieldName
        );
        return;
    }

    var notificationId =
        "date_validation_" + fieldName;

    fieldControl.clearNotification(notificationId);

    var fieldValue = fieldAttribute.getValue();
    var compareValue = compareAttribute.getValue();

    // Compare only when both dates have values
    if (!fieldValue || !compareValue) {
        return;
    }

    var currentDate = new Date(fieldValue);
    var comparisonDate = new Date(compareValue);

    currentDate.setHours(0, 0, 0, 0);
    comparisonDate.setHours(0, 0, 0, 0);

    var isValid = true;

    if (validationType === "dateComparison") {
        switch (operator) {
            case "lessThanOrEqual":
                isValid = currentDate <= comparisonDate;
                break;

            case "greaterThanOrEqual":
                isValid = currentDate >= comparisonDate;
                break;

            case "lessThan":
                isValid = currentDate < comparisonDate;
                break;

            case "greaterThan":
                isValid = currentDate > comparisonDate;
                break;

            case "equal":
                isValid =
                    currentDate.getTime() ===
                    comparisonDate.getTime();
                break;

            default:
                console.warn(
                    "Unsupported date comparison operator: " +
                    operator
                );
                return;
        }
    }

    if (!isValid) {
        fieldControl.setNotification(
            errorMessage,
            notificationId
        );
    }
}

