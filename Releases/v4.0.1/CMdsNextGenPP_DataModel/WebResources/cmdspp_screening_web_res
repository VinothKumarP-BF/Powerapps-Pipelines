var BillingSectionVisibility = (function () {
    "use strict";

    /*
     * v5 — rewritten from a console inventory of the live form.
     *
     * What the diagnostic proved:
     *   - section.setVisible(false) DOES stick (checked at 100ms/1s/3s), so
     *     the earlier CSS/DOM hiding was unnecessary and has been removed.
     *   - The real section map on tab_10 is:
     *       tab_10_section_6  "Electronic Fund Transfer"            (question)
     *       tab_10_section_8  "Financial Institution Information"   (follow-up)
     *       tab_10_section_10 "Submission Information"              (follow-up)
     *       tab_10_section_7  "Remittance Advice"                   (question)
     *       tab_10_section_9  "Electronic Remittance Advice ..."    (follow-up)
     *   - cmdspp_p_eft_ind and cmdspp_p_rmt_advice_types are NOT attributes of
     *     the host form. Each card hosts a form component control:
     *       tab_10_section_6 -> cmdspp_p_idtinf_lkup1
     *       tab_10_section_7 -> cmdspp_p_ser_ra_inf_tb_lkp
     *     Fields inside a form component control are only reachable as
     *     "<formComponentControlName>.<fieldName>". That is why every earlier
     *     version fell through to the Web API and got the answer wrong.
     */

    var VERSION = "7.3.0";
    var OWNED_ATTR = "data-cmdspp-billing-hidden";
    var STYLE_ID = "cmdspp-billing-visibility-style";
    var EFT_FLAG = "data-cmdspp-hide-eft";
    var ERA_FLAG = "data-cmdspp-hide-era";

    var CONFIG = {
        tabName: "tab_10",

        eftQuestionSection: "tab_10_section_6",
        eftSectionNames: ["tab_10_section_8", "tab_10_section_10"],
        eftIndicatorColumn: "cmdspp_p_eft_ind",
        eftLookupAttribute: "cmdspp_p_idtinf_lkup",
        eftEntityLogicalName: "cmdspp_p_idt_inf_dtl",

        eraQuestionSection: "tab_10_section_7",
        eraSectionNames: ["tab_10_section_9"],
        eraTypeColumn: "cmdspp_p_rmt_advice_types",
        eraLookupAttribute: "cmdspp_p_ser_ra_inf_tb_lkp",
        eraEntityLogicalName: "cmdspp_p_ser_ra_inf_tb",
        era835Values: [835],
        era835LabelPattern: /835/i,

        watchIntervalMs: 500,
        subgridBindRetryLimit: 40,
        subgridBindRetryMs: 250
    };

    var formContext = null;
    var applying = false;
    var refreshSequence = 0;
    var subgridBindRetryCount = 0;
    var registeredSubgridNames = {};
    var boundNestedAttributes = {};
    var reportedMissingFields = {};
    var driftCount = 0;
    var originalControlVisibility = {};
    var lastDecision = { showEft: false, showEra: false, ready: false };
    var watchTimerId = null;
    var boundWindowHandlers = false;
    var boundUiLoad = false;
    var boundDataLoad = false;
    var initialised = false;
    var subgridRetryPending = false;

    /*
     * Safe to call more than once. This is also registered on tab state
     * change in some environments, so a repeat call must not start a second
     * subgrid binding retry chain or re-log on every tab click.
     */
    function onLoad(executionContext) {
        var nextContext = executionContext && executionContext.getFormContext
            ? executionContext.getFormContext()
            : formContext;

        var isSameForm = initialised && nextContext === formContext;

        formContext = nextContext;

        if (isSameForm) {
            registerAllSubgridEvents();
            return refreshVisibility();
        }

        initialised = true;
        subgridBindRetryCount = 0;
        registeredSubgridNames = {};
        boundNestedAttributes = {};
        boundUiLoad = false;
        boundDataLoad = false;

        console.log("BillingSectionVisibility v" + VERSION + " onLoad");

        applyDecision(lastDecision.showEft, lastDecision.showEra);
        registerEvents();
        registerAllSubgridEvents();
        startWatchdog();

        return refreshVisibility();
    }

    function onSubgridLoad(executionContext) {
        if (!formContext && executionContext && executionContext.getFormContext) {
            formContext = executionContext.getFormContext();
        }
        handleSubgridLoad();
    }

    /* ---------------------------------------------------------------
     * Reading the answers out of the form component controls
     * --------------------------------------------------------------- */

    function getSection(sectionName) {
        if (!formContext) {
            return null;
        }
        var tab = formContext.ui.tabs.get(CONFIG.tabName);
        return tab ? tab.sections.get(sectionName) : null;
    }

    function getSectionControlNames(sectionName) {
        var section = getSection(sectionName);
        var names = [];
        if (!section) {
            return names;
        }
        section.controls.forEach(function (control) {
            var name;
            try { name = control.getName && control.getName(); } catch (e) { return; }
            if (name) {
                names.push(name);
            }
        });
        return names;
    }

    /*
     * Fields hosted by a form component control are addressed as
     * "<controlName>.<fieldName>". The host control name is read from the
     * question section so a renamed control keeps working.
     */
    function findNestedAttribute(questionSectionName, fieldName) {
        if (!formContext) {
            return null;
        }

        var direct = formContext.getAttribute(fieldName);
        if (direct) {
            return direct;
        }

        var controlNames = getSectionControlNames(questionSectionName);
        var tried = [];
        var i;

        for (i = 0; i < controlNames.length; i++) {
            var dotted = controlNames[i] + "." + fieldName;
            tried.push(dotted);
            var nested = formContext.getAttribute(dotted);
            if (nested) {
                return nested;
            }
        }

        /*
         * Quick view controls expose their fields through ui.quickForms
         * rather than through dotted attribute names.
         */
        var fromQuickForm = findInQuickForms(fieldName, tried);
        if (fromQuickForm) {
            return fromQuickForm;
        }

        if (!reportedMissingFields[fieldName]) {
            reportedMissingFields[fieldName] = true;
            console.log(
                "Could not reach " + fieldName + " on the form. Tried:",
                tried,
                "Using the Web API instead."
            );
        }

        return null;
    }

    function findInQuickForms(fieldName, tried) {
        if (!formContext.ui || !formContext.ui.quickForms) {
            return null;
        }

        var found = null;

        try {
            formContext.ui.quickForms.forEach(function (quickForm) {
                if (found) {
                    return;
                }
                var quickName;
                try { quickName = quickForm.getName(); } catch (e) { quickName = "?"; }
                tried.push(quickName + " (quickForm)");
                try {
                    var control = quickForm.getControl(fieldName);
                    if (control && typeof control.getAttribute === "function") {
                        found = control.getAttribute();
                    }
                } catch (e) { /* ignore */ }
            });
        } catch (e) { /* ignore */ }

        return found;
    }

    function getAttributeText(attribute) {
        try {
            return typeof attribute.getText === "function" ? attribute.getText() : null;
        } catch (e) {
            return null;
        }
    }

    async function getEftVisibility() {
        var attribute = findNestedAttribute(CONFIG.eftQuestionSection, CONFIG.eftIndicatorColumn);

        if (attribute) {
            var value = attribute.getValue();
            var show = value === true || value === 1;
            console.log("EFT answer read from form component:", value, "-> show:", show);
            return show;
        }

        var viaApi = await retrieveLookupColumn(
            CONFIG.eftLookupAttribute,
            CONFIG.eftEntityLogicalName,
            CONFIG.eftIndicatorColumn
        );

        var raw = viaApi ? viaApi.value : null;
        var showApi = raw === true || raw === 1;
        console.log("EFT answer from Web API:", raw, viaApi && viaApi.label, "-> show:", showApi);
        return showApi;
    }

    async function getEraVisibility() {
        var attribute = findNestedAttribute(CONFIG.eraQuestionSection, CONFIG.eraTypeColumn);

        if (attribute) {
            var value = attribute.getValue();
            var show = isEra835(value, getAttributeText(attribute));
            console.log("ERA answer read from form component:", value, getAttributeText(attribute), "-> show only for 835:", show);
            return show;
        }

        /*
         * The option value for the 835 selection is environment specific, so
         * the formatted label returned alongside the raw value decides this.
         */
        var viaApi = await retrieveLookupColumn(
            CONFIG.eraLookupAttribute,
            CONFIG.eraEntityLogicalName,
            CONFIG.eraTypeColumn
        );

        var raw = viaApi ? viaApi.value : null;
        var label = viaApi ? viaApi.label : null;
        var showApi = isEra835(raw, label);
        console.log("ERA answer from Web API:", raw, label, "-> show only for 835:", showApi);
        return showApi;
    }

    /*
     * The lookup's own entityType is preferred over the configured logical
     * name so a retarget of the relationship does not silently break this.
     */
    async function retrieveLookupColumn(lookupName, fallbackEntity, columnName) {
        var attribute = formContext && formContext.getAttribute(lookupName);
        if (!attribute) {
            return null;
        }

        var value = attribute.getValue();
        if (!value || !value.length || !value[0].id) {
            return null;
        }

        var entityName = value[0].entityType || fallbackEntity;
        var recordId = value[0].id.replace(/[{}]/g, "");

        try {
            var result = await Xrm.WebApi.retrieveRecord(
                entityName,
                recordId,
                "?$select=" + columnName
            );

            return {
                value: result[columnName],
                label: result[columnName + "@OData.Community.Display.V1.FormattedValue"] || null
            };
        } catch (error) {
            console.error("Retrieve failed for", entityName, columnName, error);
            return null;
        }
    }

    function isEra835(rawValue, textValue) {
        if (textValue) {
            var text = Array.isArray(textValue) ? textValue.join(" ") : String(textValue);
            if (CONFIG.era835LabelPattern.test(text)) {
                return true;
            }
        }

        if (rawValue === null || rawValue === undefined || rawValue === "") {
            return false;
        }

        var expected = CONFIG.era835Values.map(Number);

        function matches(item) {
            return expected.indexOf(Number(item)) !== -1;
        }

        if (Array.isArray(rawValue)) {
            return rawValue.some(matches);
        }

        if (typeof rawValue === "number") {
            return matches(rawValue);
        }

        return String(rawValue)
            .split(",")
            .map(function (item) { return item.trim(); })
            .some(matches);
    }

    /* ---------------------------------------------------------------
     * Applying visibility
     * --------------------------------------------------------------- */

    async function refreshVisibility(executionContext) {
        if (!formContext && executionContext && executionContext.getFormContext) {
            formContext = executionContext.getFormContext();
        }

        if (!formContext) {
            return;
        }

        var currentSequence = ++refreshSequence;

        applyDecision(lastDecision.showEft, lastDecision.showEra);

        try {
            var results = await Promise.all([getEftVisibility(), getEraVisibility()]);

            if (currentSequence !== refreshSequence) {
                return;
            }

            lastDecision = { showEft: results[0], showEra: results[1], ready: true };
            console.log("Billing visibility decision:", lastDecision);
            applyDecision(lastDecision.showEft, lastDecision.showEra);

            bindNestedAttributeEvents();
        } catch (error) {
            console.error("Billing visibility evaluation failed:", error);
            if (currentSequence === refreshSequence) {
                lastDecision = { showEft: false, showEra: false, ready: true };
                applyDecision(false, false);
            }
        }
    }

    function applyDecision(showEft, showEra) {
        if (!formContext || applying) {
            return;
        }

        applying = true;
        try {
            ensureStyle();
            setHideFlag(EFT_FLAG, !showEft);
            setHideFlag(ERA_FLAG, !showEra);
            clearLegacyInlineHides(CONFIG.eftSectionNames.concat(CONFIG.eraSectionNames));

            setSectionsVisible(CONFIG.eftSectionNames, showEft);
            setSectionsVisible(CONFIG.eraSectionNames, showEra);
            keepQuestionCardsVisible();
        } finally {
            applying = false;
        }
    }

    /*
     * setVisible does not hold for these cards: the nested model form
     * components reload and Unified Interface recomputes the section from
     * form XML, so the host form keeps switching them back on. Inline styles
     * lose the same race because React replaces the element.
     *
     * A stylesheet rule keyed off an attribute on <html> survives both. The
     * decision then costs one attribute toggle and cannot be undone by a
     * redraw.
     */
    function collectWindows() {
        var windows = [];

        function add(w) {
            if (!w) {
                return;
            }
            for (var i = 0; i < windows.length; i++) {
                if (windows[i] === w) {
                    return;
                }
            }
            try {
                if (w.document) {
                    windows.push(w);
                }
            } catch (e) { /* cross-origin */ }
        }

        if (typeof window === "undefined") {
            return windows;
        }

        add(window);
        try { add(window.parent); } catch (e) { /* ignore */ }
        try { add(window.top); } catch (e) { /* ignore */ }

        var seed = windows.slice();
        seed.forEach(function (w) {
            var frames;
            try { frames = w.document.querySelectorAll("iframe"); } catch (e) { return; }
            for (var i = 0; i < frames.length; i++) {
                try { add(frames[i].contentWindow); } catch (e) { /* cross-origin */ }
            }
        });

        return windows;
    }

    function getDocuments() {
        return collectWindows().map(function (w) {
            try { return w.document; } catch (e) { return null; }
        }).filter(Boolean);
    }

    function buildHideCss() {
        function rules(flag, names) {
            return names.map(function (name) {
                return 'html[' + flag + '] [data-id="' + name + '"]';
            }).join(",\n");
        }

        return rules(EFT_FLAG, CONFIG.eftSectionNames) + ",\n" +
            rules(ERA_FLAG, CONFIG.eraSectionNames) +
            "{display:none !important;}";
    }

    function ensureStyle() {
        getDocuments().forEach(function (doc) {
            try {
                if (doc.getElementById(STYLE_ID)) {
                    return;
                }
                var host = doc.head || doc.documentElement;
                if (!host) {
                    return;
                }
                var style = doc.createElement("style");
                style.id = STYLE_ID;
                style.appendChild(doc.createTextNode(buildHideCss()));
                host.appendChild(style);
            } catch (e) { /* ignore */ }
        });
    }

    function setHideFlag(flag, hide) {
        getDocuments().forEach(function (doc) {
            try {
                var root = doc.documentElement;
                if (!root) {
                    return;
                }
                if (hide) {
                    root.setAttribute(flag, "1");
                } else {
                    root.removeAttribute(flag);
                }
            } catch (e) { /* ignore */ }
        });
    }

    function getSectionElements(sectionName) {
        var elements = [];
        getDocuments().forEach(function (doc) {
            var nodes;
            try { nodes = doc.querySelectorAll('[data-id="' + sectionName + '"]'); } catch (e) { return; }
            for (var i = 0; i < nodes.length; i++) {
                elements.push(nodes[i]);
            }
        });
        return elements;
    }

    function isDomVisible(sectionName) {
        var elements = getSectionElements(sectionName);
        for (var i = 0; i < elements.length; i++) {
            var el = elements[i];
            var view;
            try {
                view = (el.ownerDocument && el.ownerDocument.defaultView) || window;
            } catch (e) {
                continue;
            }
            var style;
            try { style = view.getComputedStyle(el); } catch (e) { continue; }
            if (style.display !== "none" && style.visibility !== "hidden") {
                return true;
            }
        }
        return false;
    }

    function foundSectionElements() {
        var names = CONFIG.eftSectionNames.concat(CONFIG.eraSectionNames);
        for (var i = 0; i < names.length; i++) {
            if (getSectionElements(names[i]).length > 0) {
                return true;
            }
        }
        return false;
    }

    /*
     * Clears inline hides written by earlier versions of this script so a
     * card cannot stay stuck off-screen after an upgrade.
     */
    function clearLegacyInlineHides(sectionNames) {
        sectionNames.forEach(function (sectionName) {
            getSectionElements(sectionName).forEach(function (el) {
                try {
                    if (el.getAttribute(OWNED_ATTR)) {
                        el.style.removeProperty("display");
                        el.removeAttribute(OWNED_ATTR);
                    }
                } catch (e) { /* ignore */ }
            });
        });
    }

    /*
     * The question cards must never be collateral damage: if they are hidden
     * the user can no longer change the answer that drives everything else.
     */
    function keepQuestionCardsVisible() {
        [CONFIG.eftQuestionSection, CONFIG.eraQuestionSection].forEach(function (name) {
            var section = getSection(name);
            if (!section) {
                return;
            }
            try {
                if (section.getVisible() !== true) {
                    section.setVisible(true);
                }
            } catch (e) { /* ignore */ }
        });
    }

    function setSectionsVisible(sectionNames, isVisible) {
        sectionNames.forEach(function (sectionName) {
            var section = getSection(sectionName);
            if (!section) {
                console.warn("Section not found:", sectionName);
                return;
            }

            /*
             * A visible child control can pull its hidden parent section back
             * into view, so the controls are hidden alongside the section and
             * restored to their designed state when the answer allows it.
             */
            section.controls.forEach(function (control) {
                setControlVisible(control, isVisible, sectionName);
            });

            /*
             * Always re-assert. Skipping the call when getVisible() already
             * matches leaves a redrawn card on screen, because the API state
             * and the painted DOM can disagree.
             */
            try {
                section.setVisible(Boolean(isVisible));
            } catch (e) {
                console.warn("setVisible failed for", sectionName, e);
            }
        });
    }

    function setControlVisible(control, isVisible, sectionName) {
        if (!control || typeof control.setVisible !== "function") {
            return;
        }

        var controlName;
        try { controlName = control.getName && control.getName(); } catch (e) { return; }
        if (!controlName) {
            return;
        }

        var cacheKey = sectionName + "::" + controlName;
        if (!(cacheKey in originalControlVisibility)) {
            try {
                originalControlVisibility[cacheKey] = control.getVisible();
            } catch (e) {
                originalControlVisibility[cacheKey] = true;
            }
        }

        var desired = isVisible ? originalControlVisibility[cacheKey] : false;

        try {
            control.setVisible(desired);
        } catch (e) { /* ignore */ }
    }

    function needsReapply() {
        if (!formContext || !lastDecision.ready) {
            return false;
        }

        var mismatch = false;
        var haveDom = foundSectionElements();

        /*
         * What the user sees decides. The host form keeps flipping
         * section.getVisible() back on while the stylesheet keeps the card
         * off screen, so judging by the API alone would report drift forever.
         */
        function check(names, shouldShow) {
            names.forEach(function (name) {
                if (haveDom) {
                    if (isDomVisible(name) !== Boolean(shouldShow)) {
                        mismatch = true;
                    }
                    return;
                }

                var section = getSection(name);
                if (!section) {
                    return;
                }
                try {
                    if (section.getVisible() !== Boolean(shouldShow)) {
                        mismatch = true;
                    }
                } catch (e) { /* ignore */ }
            });
        }

        check(CONFIG.eftSectionNames, lastDecision.showEft);
        check(CONFIG.eraSectionNames, lastDecision.showEra);

        return mismatch;
    }

    /* ---------------------------------------------------------------
     * Events
     * --------------------------------------------------------------- */

    function registerEvents() {
        bindLookupChange(CONFIG.eftLookupAttribute);
        bindLookupChange(CONFIG.eraLookupAttribute);
        bindNestedAttributeEvents();

        if (formContext.data && formContext.data.addOnLoad && !boundDataLoad) {
            try { formContext.data.removeOnLoad(handleReload); } catch (e) { /* ignore */ }
            formContext.data.addOnLoad(handleReload);
            boundDataLoad = true;
        }

        if (formContext.ui && formContext.ui.addOnLoad && !boundUiLoad) {
            try { formContext.ui.removeOnLoad(handleReload); } catch (e) { /* ignore */ }
            formContext.ui.addOnLoad(handleReload);
            boundUiLoad = true;
        }

        var tab = formContext.ui.tabs.get(CONFIG.tabName);
        if (tab) {
            try { tab.removeTabStateChange(handleTabStateChange); } catch (e) { /* ignore */ }
            tab.addTabStateChange(handleTabStateChange);
        }

        if (!boundWindowHandlers && typeof window !== "undefined") {
            boundWindowHandlers = true;
            window.addEventListener("focus", handleWindowFocus, true);
            window.addEventListener("visibilitychange", function () {
                if (document.visibilityState === "visible") {
                    handleWindowFocus();
                }
            });
        }
    }

    function bindLookupChange(attributeName) {
        var attribute = formContext.getAttribute(attributeName);
        if (!attribute) {
            return;
        }
        try { attribute.removeOnChange(handleAnswerChange); } catch (e) { /* ignore */ }
        attribute.addOnChange(handleAnswerChange);
    }

    /*
     * Form component attributes appear only once the embedded form has
     * loaded, so binding is retried rather than done once at form load.
     */
    function bindNestedAttributeEvents() {
        var targets = [
            { section: CONFIG.eftQuestionSection, field: CONFIG.eftIndicatorColumn },
            { section: CONFIG.eraQuestionSection, field: CONFIG.eraTypeColumn }
        ];

        targets.forEach(function (target) {
            var attribute = findNestedAttribute(target.section, target.field);
            if (!attribute) {
                return;
            }

            var key;
            try { key = attribute.getName(); } catch (e) { key = target.field; }

            if (boundNestedAttributes[key]) {
                return;
            }

            try {
                attribute.removeOnChange(handleAnswerChange);
            } catch (e) { /* ignore */ }

            try {
                attribute.addOnChange(handleAnswerChange);
                boundNestedAttributes[key] = true;
                console.log("Bound billing answer field:", key);
            } catch (e) { /* ignore */ }
        });
    }

    function registerAllSubgridEvents() {
        if (!formContext || !formContext.ui || !formContext.ui.controls) {
            scheduleSubgridBindRetry();
            return;
        }

        formContext.ui.controls.forEach(function (control) {
            var type;
            try { type = control.getControlType && control.getControlType(); } catch (e) { return; }
            if (type !== "subgrid") {
                return;
            }

            var name;
            try { name = control.getName && control.getName(); } catch (e) { return; }
            if (!name || registeredSubgridNames[name]) {
                return;
            }

            try { control.removeOnLoad(handleSubgridLoad); } catch (e) { /* ignore */ }

            try {
                control.addOnLoad(handleSubgridLoad);
                registeredSubgridNames[name] = true;
                console.log("Billing visibility bound to subgrid:", name);
            } catch (e) { /* ignore */ }
        });

        scheduleSubgridBindRetry();
    }

    function scheduleSubgridBindRetry() {
        if (subgridBindRetryCount >= CONFIG.subgridBindRetryLimit || subgridRetryPending) {
            return;
        }
        subgridBindRetryCount++;
        subgridRetryPending = true;
        window.setTimeout(function () {
            subgridRetryPending = false;
            registerAllSubgridEvents();
        }, CONFIG.subgridBindRetryMs);
    }

    function handleAnswerChange() {
        refreshVisibility();
    }

    function handleSubgridLoad() {
        applyDecision(lastDecision.showEft, lastDecision.showEra);
        refreshVisibility();
        subgridBindRetryCount = 0;
        registerAllSubgridEvents();
    }

    function handleReload() {
        applyDecision(lastDecision.showEft, lastDecision.showEra);
        refreshVisibility();
        subgridBindRetryCount = 0;
        registerAllSubgridEvents();
    }

    function handleTabStateChange() {
        var tab = formContext && formContext.ui.tabs.get(CONFIG.tabName);
        if (tab && tab.getDisplayState() === "expanded") {
            applyDecision(lastDecision.showEft, lastDecision.showEra);
            refreshVisibility();
        }
    }

    function handleWindowFocus() {
        applyDecision(lastDecision.showEft, lastDecision.showEra);
        refreshVisibility();
    }

    /*
     * Cheap safety net: only re-applies when a section drifted away from the
     * decision, which is what happens when Unified Interface redraws the tab
     * after a subgrid dialog closes.
     */
    function startWatchdog() {
        if (watchTimerId) {
            return;
        }

        watchTimerId = window.setInterval(function () {
            if (applying || !lastDecision.ready) {
                return;
            }
            if (needsReapply()) {
                driftCount++;
                // One line per burst instead of one per tick.
                if (driftCount === 1 || driftCount % 40 === 0) {
                    console.log("Billing sections drifted on screen. Re-applying. Count:", driftCount);
                }
                applyDecision(lastDecision.showEft, lastDecision.showEra);
                bindNestedAttributeEvents();
            } else {
                driftCount = 0;
            }
        }, CONFIG.watchIntervalMs);
    }

    function diagnose() {
        if (!formContext) {
            console.error("Form not loaded.");
            return;
        }

        console.log("BillingSectionVisibility v" + VERSION);
        console.log("Decision:", lastDecision);

        var eft = findNestedAttribute(CONFIG.eftQuestionSection, CONFIG.eftIndicatorColumn);
        var era = findNestedAttribute(CONFIG.eraQuestionSection, CONFIG.eraTypeColumn);

        console.log("EFT attribute:", eft ? eft.getName() : "NOT FOUND", eft ? eft.getValue() : null);
        console.log("ERA attribute:", era ? era.getName() : "NOT FOUND", era ? era.getValue() : null);

        console.log("documents reachable:", getDocuments().length, "section nodes found:", foundSectionElements());

        CONFIG.eftSectionNames.concat(CONFIG.eraSectionNames).forEach(function (name) {
            var section = getSection(name);
            console.log(name, {
                label: section ? section.getLabel() : "MISSING",
                apiVisible: section ? section.getVisible() : null,
                painted: isDomVisible(name)
            });
        });
    }

    return {
        onLoad: onLoad,
        onSubgridLoad: onSubgridLoad,
        refreshVisibility: refreshVisibility,
        enforceVisibilityOverRenderCycle: handleSubgridLoad,
        diagnose: diagnose,
        VERSION: VERSION
    };
})();


/*
 * Unified Interface evaluates a web resource inside a wrapper scope, so a
 * top-level `var` does not necessarily become a property of the window. A
 * handler registered in the form designer as "BillingSectionVisibility.onLoad"
 * is resolved against the global object and fails with "Web resource method
 * does not exist". Publishing the namespace explicitly keeps dotted handler
 * names working, and makes the object reachable from the browser console.
 */
(function publishBillingNamespace() {
    var host = null;

    if (typeof globalThis !== "undefined") {
        host = globalThis;
    } else if (typeof window !== "undefined") {
        host = window;
    }

    if (!host) {
        return;
    }

    host.BillingSectionVisibility = BillingSectionVisibility;

    try {
        if (window.top && window.top !== host && !window.top.BillingSectionVisibility) {
            window.top.BillingSectionVisibility = BillingSectionVisibility;
        }
    } catch (e) { /* cross-origin */ }
})();

function onFormLoad(executionContext) {
    return BillingSectionVisibility.onLoad(executionContext);
}

