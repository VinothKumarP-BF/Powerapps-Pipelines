async function createInquiryOnSave(executionContext) {

    var formContext = executionContext.getFormContext();

    var recordId = formContext.data.entity.getId();

    if (!recordId) {
        console.log("Record not saved yet.");
        return;
    }

    recordId = recordId.replace(/[{}]/g, "");

    var configs = [
        { override: "cmdspp_p_oigleie_ovrd", reason: "cmdspp_p_oigleie_ovrd_reason", riskType: "OIG/LEIE" },
        { override: "cmdspp_p_sam_exclu_ovrd", reason: "cmdspp_p_sam_exclu_ovrd_reason", riskType: "SAM" },
        { override: "cmdspp_p_nppes_ovrd", reason: "cmdspp_p_nppes_ovrd_reason", riskType: "NPPES" },
        { override: "cmdspp_p_dea_ovrd", reason: "cmdspp_p_dea_ovrd_reason", riskType: "DEA" },
        { override: "cmdspp_p_license_ovrd", reason: "cmdspp_p_license_ovrd_reason", riskType: "License" },
        { override: "cmdspp_p_tin_ovrd", reason: "cmdspp_p_tin_ovrd_reason", riskType: "TIN" },
        { override: "cmdspp_p_pecos_ovrd", reason: "cmdspp_p_pecos_ovrd_reason", riskType: "PECOS" },
        { override: "cmdspp_p_ownership_ovrd", reason: "cmdspp_p_ownership_ovrd_reason", riskType: "Ownership" },
        { override: "cmdspp_p_clia_ovrd", reason: "cmdspp_p_clia_ovrd_reason", riskType: "CLIA" }
    ];

    // Build the $select list dynamically: every override field, every reason field,
    // plus the lookup field's raw guid value
    var selectFields = [];
    configs.forEach(function (item) {
        selectFields.push(item.override);
        selectFields.push(item.reason);
    });
    selectFields.push("_cmdspp_p_appl_id_fk_value");

    var PARENT_LOGICAL_NAME = "cmdspp_p_appl_scenario_tb";

    var record;
    try {
        record = await Xrm.WebApi.retrieveRecord(
            PARENT_LOGICAL_NAME,
            recordId,
            "?$select=" + selectFields.join(",")
        );
    } catch (e) {
        console.error("Failed to fetch record " + recordId, e);
        return;
    }

    var parentId = record["_cmdspp_p_appl_id_fk_value"];

    if (!parentId) {
        console.log("cmdspp_p_appl_id_fk is empty on this record. Cannot create inquiry.");
        return;
    }



    configs.forEach(function (item) {

        var overrideValue = record[item.override];


        // Value currently on the form (live, in-memory)
        var formOverrideValue =
            formContext.getAttribute(item.override)?.getValue();

        // Already inserted previously
        if (overrideValue === true) {
            return;
        }

        // Current override not selected
        if (!formOverrideValue) {
            return;
        }
        var LoggedInUserName = getLoggedInUserName(executionContext);
        console.log("Logged in user name: " + LoggedInUserName);
        var reason = formContext.getAttribute(item.reason)?.getValue() || "";

        console.log("Creating inquiry for " + item.riskType + " override. Reason: " + reason);

        var inquiryDesc = "Risk overridden by " + LoggedInUserName + " with " + reason;

        var data = {
            "cmdspp_p_inquiry_desc": inquiryDesc,
            "cmdspp_p_event_dt": new Date(),
            "cmdspp_p_inquiry_status": item.riskType + " Risk overridden",
            "cmdspp_p_sys_id_fk@odata.bind": "/cmdspp_p_dtl_tbs(" + record._cmdspp_p_appl_id_fk_value + ")",
            "cmdspp_loggeduser": LoggedInUserName
        };

        Xrm.WebApi.createRecord(
            "cmdspp_p_enrol_status_inquiry_tb",
            data
        ).then(
            function (createResult) {
                console.log(item.riskType + " inquiry created: " + createResult.id);
            },
            function (error) {
                console.error("Create Error: " + error.message);
            }
        );

    });
}

async function createInquiry(
    executionContext,
    sourceTableName,        // Fetch table
    sourceRecordId,         // Record Id
    sourceFields,            // Array of fields to fetch, e.g. ["_cmdspp_p_doc_to_p_dtl_fk_value", "cmdspp_p_docu_nam"]
    placeholderNames,        // Array matching sourceFields, e.g. ["sysId", "documentName"]
    inquiryTableName,       // Insert table
    descriptionTemplate,    // e.g. "Document {documentName} Attached by {userName}"
    status,
    inquiryDescField,
    inquiryStatusField,
    inquirySysIdField,
    inquiryUserField,
    documentName
) {
    try {

        var LoggedInUserName = getLoggedInUserName(executionContext);

        var record = await Xrm.WebApi.retrieveRecord(
            sourceTableName,
            sourceRecordId.replace(/[{}]/g, ""),
            "?$select=" + sourceFields.join(",")
        );

        // Build a values object dynamically: { sysId: ..., documentName: ... }
        var values = {};
        for (var i = 0; i < sourceFields.length; i++) {
            values[placeholderNames[i]] = record[sourceFields[i]];
        }
        values["userName"] = LoggedInUserName;
        values["documentName"] = documentName;
        var sysId = values["sysId"];

        if (!sysId) {
            console.log("Sys Id not found.");
            return;
        }

        // Replace every {placeholder} in the template dynamically
        var description = descriptionTemplate;
        for (var key in values) {
            description = description.replace("{" + key + "}", values[key]);
        }

