                          "emailMessage/Subject": "Verification PIN",
                          "emailMessage/Body": "\n\n\n\n<table cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f3f3;padding:20px;\">\n<tbody><tr>\n<td>\n\n<table cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:4px;overflow:hidden;\">\n\n<tbody><tr>\n<td style=\"background:#1f3b6d;color:white;padding:24px;text-align:center;font-size:28px;\">\nCMDS NextGen Provider Portal\n</td>\n</tr>\n\n<tr>\n<td style=\"padding:35px;color:#333333;font-size:16px;line-height:1.6;\">\n\n<p>Hi @{outputs('Update_a_row_user')?['body/cmdspp_g_fst_nam']},</p>\n\n<p>\nYour verification PIN is ready. Please enter this PIN in the portal to proceed. This PIN will expire in 15 minutes.\n</p>\n\n<div style=\"text-align:center;padding:25px 0;\">\n<div style=\"display:inline-block;\nbackground:#f5f7fa;\nborder:1px solid #d9dde5;\nborder-radius:6px;\npadding:25px 50px;\">\n<div style=\"font-size:11px;\nletter-spacing:2px;\ncolor:#7a8494;\nmargin-bottom:10px;\">\nYOUR PIN\n</div>\n\n<div style=\"font-size:42px;\nletter-spacing:8px;\ncolor:#1f3b6d;\nfont-weight:300;\">\n@{outputs('Compose')}\n</div>\n</div>\n</div>\n\n<div style=\"background:#fff8e5;\nborder:1px solid #e8d38b;\nborder-radius:4px;\npadding:15px;\ncolor:#8a6d3b;\nfont-size:14px;\">\n\nSecurity notice: For your protection, do not share this PIN with anyone.\nCMDS staff will never ask for your PIN.\n\n</div>\n\n<p style=\"margin-top:30px;\">\nThank you,<br>\nCMDS Next Gen Provider Portal Support Team\n</p>\n\n</td>\n</tr>\n\n<tr>\n<td style=\"background:#f1f3f5;\npadding:20px;\nfont-size:12px;\ncolor:#888888;\ntext-align:center;\">\n\nThis is an automated message from the CMDS Next Gen Provider Portal.\nPlease do not reply directly to this email.<br><br>\n\n© @{formatDateTime(utcNow(),'yyyy')} CMDS Next Gen Provider Portal. All rights reserved.\n\n</td>\n</tr>\n\n</tbody></table>\n\n</td>\n</tr>\n</tbody></table>\n\n\n",
                          "emailMessage/Importance": "Normal"
