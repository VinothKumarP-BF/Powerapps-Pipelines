                    "parameters": {
                      "emailMessage/To": "@triggerBody()?['userEmail']",
                      "emailMessage/Subject": "Application Submitted Successfully",
                      "emailMessage/Body": "<div style=\"margin:0;padding:0;background-color:#f4f5f7;font-family:Segoe UI, Arial, sans-serif;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#f4f5f7;\">\n        <tr>\n            <td align=\"center\">\n                <div style=\"border-radius:6px;overflow:hidden; width:600px\">\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"background:#ffffff;border:1px solid #d6dce6;\">\n\n                    <!-- Header -->\n                    <tr>\n                        <td align=\"center\"\n                            style=\"background:#1A3A5C;padding:28px 20px;color:#FFFFFFE5;font-size:22px;font-weight:400;\">\n                            CMDS NextGen Provider Portal\n                        </td>\n                    </tr>\n\n                    <!-- Body -->\n                    <tr>\n                        <td style=\"padding:32px 39px;color:#2C3E50;font-size:15px;font-weight:400;line-height:1.8;\">\n\n                            <p style=\"margin:0 0 24px 0;color:#2C3E50;font-size:15px;font-weight:400;\">\n                                Hi @{triggerBody()?['userName']},\n                            </p>\n\n                            <p style=\"margin:0 0 24px 0;color:#2C3E50;font-size:15px;font-weight:400;\">\n                                Thank you for submitting your application through the CMDS Next Gen\n                                Provider Portal. We have successfully received your application,\n                                and it is now under review.\n                            </p>\n\n                            <!-- Application Details Box -->\n                            <div style=\"border-radius:6px;overflow:hidden; width:100%\">\n                            <table role=\"presentation\"\n                                   cellpadding=\"0\"\n                                   cellspacing=\"0\"\n                                   border=\"0\"\n                                   width=\"100%\"\n                                   style=\"border:1px solid #1A3A5C;border-left:4px solid #1A3A5C;border-radius:6px;background:#F4F7FB;\">\n\n                                <tr>\n                                    <td colspan=\"2\"\n                                        style=\"padding:18px 22px 10px 22px;color:#5A6A80;font-size:11px;font-weight:400;letter-spacing:0.88px;\">\n                                        APPLICATION DETAILS\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td style=\"padding:8px 22px;color:#5A6A80;font-size:13px;font-weight:400;border-bottom:1px solid #dfe5ee;\">\n                                        Application ID\n                                    </td>\n                                    <td align=\"right\"\n                                        style=\"padding:8px 22px;color:#1A3A5C;font-size:13px;font-weight:400;border-bottom:1px solid #dfe5ee;\">\n                                        @{triggerBody()?['applicationId']}\n                                    </td>\n                                </tr>\n\n                                <tr>\n                                    <td style=\"padding:10px 22px;color:#5A6A80;font-size:13px;font-weight:400;\">\n                                        Submission Date\n                                    </td>\n                                    <td align=\"right\"\n                                        style=\"padding:10px 22px;color:#1A3A5C;font-size:13px;font-weight:400;\">\n                                        @{formatDateTime(utcNow(),'MM/dd/yyyy')}\n                                    </td>\n                                </tr>\n\n                            </table>\n                            </div> \n                            <p style=\"margin:24px 0 24px 0;color:#2C3E50;font-size:15px;font-weight:400;\">\n                                You can log in to the portal at any time to track the status of your\n                                application and view updates. We will notify you once the review\n                                process is completed or if any additional information is required.\n                            </p>\n\n                            <p style=\"margin:0 0 25px 0;color:#2C3E50;font-size:15px;font-weight:400;\">\n                                Thank you for your submission.\n                            </p>\n\n                            <p style=\"margin:0;color:#5A6A80;font-size:14px;font-weight:400;\">\n                                Best regards,\n                            </p>\n\n                            <p style=\"margin:4px 0 0 0;color:#1A2A3A;font-size:13px;font-weight:400;\">\n                                CMDS Next Gen Provider Portal Support Team\n                            </p>\n\n                        </td>\n                    </tr>\n\n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"background:#F8F9FC;padding:24px 30px;text-align:center;color:#8A9AB0;font-size:11px;line-height:17.6px;\">\n\n                            <div>\n                                This is an automated message from the CMDS NextGen Provider Portal.\n                                Please do not reply directly to this email.\n                            </div>\n\n                            <div style=\"margin-top:10px;\">\n                                © @{formatDateTime(utcNow(),'yyyy')} CMDS Next Gen Provider Portal. All rights reserved.\n                            </div>\n\n                        </td>\n                    </tr>\n\n                </table>\n               </div>\n            </td>\n        </tr>\n    </table>\n</div>",
                      "emailMessage/Importance": "Normal"
