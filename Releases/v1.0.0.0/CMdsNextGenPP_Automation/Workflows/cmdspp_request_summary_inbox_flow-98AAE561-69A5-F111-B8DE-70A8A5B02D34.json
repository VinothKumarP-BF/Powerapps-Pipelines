            "parameters": {
              "emailMessage/To": "@first(body('List_rows')?['value'])?['cmdspp_p_createdby_user_id']?['cmdspp_g_email']",
              "emailMessage/Subject": "New Secure Message Available",
              "emailMessage/Body": "<div style=\"margin:0;padding:0;background-color:#ffffff;font-family:Segoe UI, Arial, sans-serif;\">\n\n    <table role=\"presentation\"\n           cellpadding=\"0\"\n           cellspacing=\"0\"\n           border=\"0\"\n           width=\"100%\"\n           style=\"background-color:#ffffff;\">\n\n        <tr>\n            <td align=\"center\">\n\n                <!-- Main Container -->\n                <table role=\"presentation\"\n                       cellpadding=\"0\"\n                       cellspacing=\"0\"\n                       border=\"0\"\n                       width=\"866\"\n                       style=\"background:#ffffff;\">\n\n                    <!-- Header -->\n                    <tr>\n                        <td align=\"center\"\n                            style=\"background:#263B68;\n                                   padding:34px 20px;\n                                   color:#FFFFFF;\n                                   font-size:28px;\n                                   font-weight:400;\n                                   line-height:1.2;\">\n\n                            CMdS NextGen Provider Portal\n                            <br>\n                            – New Secure Message Available\n\n                        </td>\n                    </tr>\n\n                    <!-- Body -->\n                    <tr>\n                        <td style=\"padding:55px 58px 30px 58px;\n                                   color:#2C3E50;\n                                   font-size:20px;\n                                   line-height:1.7;\">\n\n                            <p style=\"margin:0 0 35px 0;\">\n                                Hi @{first(body('List_rows')?['value'])?['cmdspp_p_fst_nam']},\n                            </p>\n\n                            <p style=\"margin:0 0 10px 0;\">\n                                You have a new secure message regarding your Provider Enrollment.\n                            </p>\n\n                            <p style=\"margin:0 0 45px 0;\">\n                                Please log in to the Provider Portal to view your message.\n                            </p>\n\n                            <p style=\"margin:0 0 5px 0;color:#6B7A90;\">\n                                Thank you,\n                            </p>\n\n                            <p style=\"margin:0;color:#344B70;\">\n                                CMDS Next Gen Provider Portal Support Team\n                            </p>\n\n                        </td>\n                    </tr>\n\n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"background:#F5F7FA;\n                                   padding:32px 40px;\n                                   text-align:center;\n                                   color:#8A9AB0;\n                                   font-size:14px;\n                                   line-height:1.6;\">\n\n                            <div>\n                                This is an automated message from the CMDS Next Gen Provider Portal.\n                                Please do not reply directly to this email.\n                            </div>\n\n                            <div style=\"margin-top:12px;\">\n                                © @{formatDateTime(utcNow(),'yyyy')} CMDS Next Gen Provider Portal · All rights reserved\n                            </div>\n\n                        </td>\n                    </tr>\n\n                </table>\n\n            </td>\n        </tr>\n\n    </table>\n\n</div>",
              "emailMessage/Importance": "Normal"
