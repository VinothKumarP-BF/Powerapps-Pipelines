          "runAfter": {
            "Compose_Dynamic_Folder": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "3ba78a8f-f2e3-49e7-8907-79ff027538f1"
          },
          "type": "Scope"
        },
        "Scope_Create_Folder_If_Missing": {
          "actions": {
