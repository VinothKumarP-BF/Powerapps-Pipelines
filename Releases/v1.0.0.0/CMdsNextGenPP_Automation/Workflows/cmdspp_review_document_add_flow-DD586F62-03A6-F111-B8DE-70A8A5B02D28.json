                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@body('Parse_JSON_-_SharePoint_Config')?['siteAddress']",
                  "table": "@body('Parse_JSON_-_SharePoint_Config')?['libraryName']",
                  "parameters/path": "@concat(\r\nbody('Parse_JSON_-_SharePoint_Config')?['reviewDocumentsFolderPath'],\r\ntriggerOutputs()?['body/cmdspp_p_enrol_id']\r\n)"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Scope_Check_Folder": [
              "Failed"
