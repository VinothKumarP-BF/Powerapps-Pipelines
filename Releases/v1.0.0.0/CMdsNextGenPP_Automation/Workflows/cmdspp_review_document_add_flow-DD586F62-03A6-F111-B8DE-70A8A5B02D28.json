            ]
          },
          "metadata": {
            "operationMetadataId": "f2fe0a4a-6fd1-4196-b531-a62e37177bec"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline_1",
              "operationId": "GetFileItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@body('Parse_JSON_-_SharePoint_Config')?['siteAddress']",
              "table": "@body('Parse_JSON_-_SharePoint_Config')?['libraryName']",
              "id": "@outputs('Create_file')?['body/ItemId']"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}