              "runAfter": {},
              "metadata": {
                "operationMetadataId": "86793934-4149-4e30-a86b-53376bcb5822"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline_1",
