          "inputs": "@first(body('Filter_array_-_SharePoint_Definition_Id'))?['environmentvariabledefinitionid']"
        },
        "List_rows_-_Env_Values": {
          "runAfter": {
            "Compose_-_SharePoint_Definition_Id": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "eb6fbb27-8e99-4b8f-8c4d-2233cfa57421"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "environmentvariablevalues",
              "$filter": "_environmentvariabledefinitionid_value eq @{outputs('Compose_-_SharePoint_Definition_Id')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Filter_array_-_SharePoint_Value": {
          "runAfter": {
