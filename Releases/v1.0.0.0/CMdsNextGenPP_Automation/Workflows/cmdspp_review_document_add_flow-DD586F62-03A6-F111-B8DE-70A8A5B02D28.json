          },
          "type": "Compose",
          "inputs": "@ concat(\r\nbody('Parse_JSON_-_SharePoint_Config')?['reviewDocumentsFolderPath'],\r\ntriggerOutputs()?['body/cmdspp_p_enrol_id'])  "
        },
        "Scope_Check_Folder": {
          "actions": {
            "Get_folder_metadata": {
              "runAfter": {},
              "metadata": {
