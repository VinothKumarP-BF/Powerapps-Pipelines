          "metadata": {
            "operationMetadataId": "2c28244f-b3c9-4ca3-9720-4b25b686f710"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "GetEntityFileImageFieldContent",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "cmdspp_p_documents_tbs",
              "recordId": "@triggerOutputs()?['body/cmdspp_p_documents_tbid']",
              "fileImageFieldName": "cmdspp_p_file"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Compose_file_content": {
          "runAfter": {
            "Download_a_file_or_an_image": [
