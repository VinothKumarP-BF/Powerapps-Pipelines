          "metadata": {
            "operationMetadataId": "a482da10-4478-4d80-a3ea-386b66f171ba"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('List_rows')?['body/value']",
            "where": "@equals(item()?['schemaname'], 'cmdspp_ENV_SharePointPath_Config')"
          }
        },
        "Compose_-_SharePoint_Definition_Id": {
          "runAfter": {
            "Filter_array_-_SharePoint_Definition_Id": [
