            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Scope_Create_File": {
          "actions": {
            "Create_file": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "6ce7cb95-00ee-47aa-982e-415bdb1981bd"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline_1",
                  "operationId": "CreateFile",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@body('Parse_JSON_-_SharePoint_Config')?['siteAddress']",
                  "folderPath": "@outputs('Compose_Dynamic_Folder')",
                  "name": "@triggerOutputs()?['body/cmdspp_p_file_nam']",
                  "body": "@body('Download_a_file_or_an_image')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            }
          },
          "runAfter": {
            "Scope_Create_Folder_If_Missing": [
              "Succeeded",
              "Skipped"
            ],
            "Scope_Check_Folder": [
              "Succeeded",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "20c554db-317b-4da5-968f-422bc6fa5fcd"
          },
          "type": "Scope"
        },
        "Perform_an_unbound_action": {
          "runAfter": {
