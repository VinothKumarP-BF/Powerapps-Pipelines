            "operationMetadataId": "81e10f01-68b3-4cf9-8640-a820c2ef0a43"
          },
          "type": "Query",
          "inputs": {
            "from": "@outputs('List_rows_-_Env_Values')?['body/value']",
            "where": "@equals(item()?['_environmentvariabledefinitionid_value'], outputs('Compose_-_SharePoint_Definition_Id'))"
          }
        },
        "Compose_-_SharePoint_Config_Raw": {
          "runAfter": {
            "Filter_array_-_SharePoint_Value": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5d55c741-bfb8-448e-8360-16afe2f507d2"
          },
          "type": "Compose",
          "inputs": "@if(\r\n  empty(body('Filter_array_-_SharePoint_Value')),\r\n  first(body('Filter_array_-_SharePoint_Definition_Id'))?['defaultvalue'],\r\n  first(body('Filter_array_-_SharePoint_Value'))?['value']\r\n)"
        },
        "Parse_JSON_-_SharePoint_Config": {
          "runAfter": {
            "Compose_-_SharePoint_Config_Raw": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "cf49642f-a5d9-456c-8004-309a2d9dbaca"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@outputs('Compose_-_SharePoint_Config_Raw')",
            "schema": {
              "type": "object",
              "properties": {
                "siteAddress": {
                  "type": "string"
                },
                "libraryName": {
                  "type": "string"
                },
                "folderPath": {
                  "type": "string"
                },
                "configFolderPath": {
                  "type": "string"
                },
                "screeningFolderPath": {
                  "type": "string"
                },
                "parametersPath": {
                  "type": "string"
                },
                "parametersConfigPath": {
                  "type": "string"
                },
                "parametersScreeningPath": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Download_a_file_or_an_image": {
          "runAfter": {
